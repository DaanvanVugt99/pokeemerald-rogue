script Rogue_RouteEvent_AnomalousFossilRestoration
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        bufferspeciesname(STR_VAR_1, VAR_0x8004)
        msgbox(format("Just look at that {STR_VAR_1}! Take good care of it—we may never see another like it."))
    }
    else
    {
        special(RogueRouteEvents_BufferFossilRestorationData)
        msgbox(format("Ah, you brought the {STR_VAR_3}!\pI can restore it two ways. Stable keeps its {STR_VAR_1} type. Adaptive brings out {STR_VAR_2}.\pWhich method should I use?"))

        begindynamicmultichoice(16)
        appenddynamicmultichoice("Stable", ROGUE_FOSSIL_RESTORATION_STABLE)
        appenddynamicmultichoice("Adaptive", ROGUE_FOSSIL_RESTORATION_ADAPTIVE)
        appenddynamicmultichoice("Not yet", MULTI_B_PRESSED)
        enddynamicmultichoice(1, 0, 3, TRUE)

        if(var(VAR_RESULT) != MULTI_B_PRESSED)
        {
            copyvar(VAR_0x8004, VAR_RESULT)
            if(var(VAR_0x8004) == ROGUE_FOSSIL_RESTORATION_STABLE)
            {
                msgbox(format("Preserve its original typing?"), MSGBOX_YESNO)
            }
            else
            {
                msgbox(format("Draw out its adaptive typing?"), MSGBOX_YESNO)
            }

            if(var(VAR_RESULT) == YES)
            {
                call(Rogue_RouteEvent_AnomalousFossilTryRestore)
            }
        }
        else
        {
            msgbox(format("Take your time. The fossil has waited this long already."))
        }
    }

    release
}

script Rogue_RouteEvent_AnomalousFossilTryRestore
{
    setvar(VAR_0x8006, PARTY_NOTHING_CHOSEN)
    special(RogueRouteEvents_TryRestoreAnomalousFossil)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_PARTY_FULL)
    {
        msgbox(format("Your party is full. One Pokémon will have to be released before I begin. Make room?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("No harm done. Bring the fossil back when you are ready."))
            return
        }

        copyvar(VAR_0x8005, VAR_0x8004)
        special(ChoosePartyMon)
        waitstate
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            msgbox(format("Changed your mind? That's fine. No Pokémon was released."))
            return
        }

        copyvar(VAR_0x8006, VAR_0x8004)
        bufferpartymonnick(STR_VAR_1, VAR_0x8006)
        msgbox(format("Release {STR_VAR_1} and complete the restoration?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("We'll leave things as they are. No Pokémon was released."))
            return
        }

        copyvar(VAR_0x8004, VAR_0x8005)
        if(var(VAR_0x8006) == 0)
        {
            call(Rogue_ScriptHideFollower)
        }
        special(RogueRouteEvents_TryRestoreAnomalousFossil)
        copyvar(VAR_0x8007, VAR_RESULT)
        if(var(VAR_0x8006) == 0)
        {
            call(Rogue_ScriptShowFollower)
        }
        copyvar(VAR_RESULT, VAR_0x8007)
    }

    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        call(Rogue_Common_DisplayPopups)
        msgbox(format("It's alive!\pYour rare Pokémon was revived at Lv. 1."))
    }
    else
    {
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_MISSING_ITEM)
        {
            msgbox(format("Where is the fossil? Bring it back, and I can finish what we started."))
        }
        else
        {
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_CANT_GIVE_MON)
            {
                msgbox(format("Your current challenge won't allow this Pokémon to join you. Don't worry—the fossil is safe."))
            }
            else
            {
                msgbox(format("Something interrupted the process. The fossil is safe, so we can try again."))
            }
        }
    }

    return
}

