const VAR_ITEM_INDEX = VAR_0x8000
const VAR_ITEM_ID_VAL = VAR_0x8001
const VAR_ITEM_AMOUNT = VAR_0x8002
const VAR_SHOP_DIFFICULTY = VAR_0x8000
const VAR_SHOP_RANDOM_IDX = VAR_TEMP_F
const VAR_SAFARI_INDEX = VAR_0x8008
const VAR_SAFARI_SELECTED_INDEX = VAR_TEMP_A
const VAR_SAFARI_PURCHASE_CONTEXT = VAR_0x8000
const VAR_SAFARI_COST_COUNT = VAR_0x8004

const SAFARI_PURCHASE_CONTEXT_AREA = 0
const SAFARI_PURCHASE_CONTEXT_CAVE = 1

const SAFARI_PURCHASE_TO_PARTY = 0
const SAFARI_PURCHASE_TO_PC = 1
const SAFARI_PURCHASE_CANT_GIVE = 2
const SAFARI_PURCHASE_NOT_ENOUGH = 3
const SAFARI_PURCHASE_INVALID = 4

const SAFARI_SELECTED_BUY = 10
const SAFARI_SELECTED_DISMISS = 11
const SAFARI_SELECTED_BACK = 12

const ROGUE_ROUTE_EVENT_ANCHOR_SENDER = 0
const ROGUE_ROUTE_EVENT_ANCHOR_RECIPIENT = 1

const ROGUE_ROUTE_EVENT_STATE_NOT_STARTED = 0
const ROGUE_ROUTE_EVENT_STATE_ACTIVE = 1
const ROGUE_ROUTE_EVENT_STATE_REWARD_PENDING = 2
const ROGUE_ROUTE_EVENT_STATE_COMPLETED = 3

const ROGUE_ROUTE_EVENT_RESULT_FAILED = 0
const ROGUE_ROUTE_EVENT_RESULT_SUCCESS = 1
const ROGUE_ROUTE_EVENT_RESULT_MISSING_ITEM = 2
const ROGUE_ROUTE_EVENT_RESULT_NO_SPACE = 3

const POKEDEX_SELECTION_CURATED = 0
const POKEDEX_SELECTION_TRIAL = 1

// Re-used scripts
//

script Rogue_RouteEvent_Interact
{
    end
}

script Rogue_RouteEvent_Prop
{
    lock
    faceplayer

    msgbox(format("These supplies belong to the nearby traveler."))

    release
}

script Rogue_RouteEvent_Delivery
{
    lock
    faceplayer

    if(var(VAR_ROGUE_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_NOT_STARTED)
    {
        msgbox(format("Excuse me! I need this Parcel delivered, but I cannot leave my post.\pWould you take it?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            special(RogueRouteEvents_TryAcceptDelivery)
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
            {
                playfanfare(MUS_OBTAIN_ITEM)
                waitfanfare
                msgbox(format("Thank you! Keep an eye out for the recipient during a future route."))
            }
            else
            {
                msgbox(format("It looks like there isn't room in your Bag right now."))
            }
        }
        else
        {
            msgbox(format("No problem. Let me know if you change your mind."))
        }
    }
    elif(var(VAR_ROGUE_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_ACTIVE)
    {
        msgbox(format("Thank you. The recipient should cross your path before long."))
    }
    else
    {
        msgbox(format("Thanks again for taking care of that delivery!"))
    }

    release
}

script Rogue_RouteEvent_DeliveryPayoff
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    bufferitemname(STR_VAR_1, VAR_0x8004)

    if(var(VAR_ROGUE_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("Thanks again for delivering the Parcel!"))
    }
    else
    {
        msgbox(format("That Parcel is for me! I can give you a {STR_VAR_1} for bringing it."))
        special(RogueRouteEvents_TryCompleteDelivery)
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
        {
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare
            msgbox(format("Perfect! Thank you for making the delivery."))
        }
        else
        {
            msgbox(format("You'll need the Parcel and room in your Bag for the reward."))
        }
    }

    release
}

script Rogue_RouteEvent_SupplyRequest
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    bufferitemname(STR_VAR_1, VAR_0x8005)
    bufferitemname(STR_VAR_2, VAR_0x8004)

    if(var(VAR_ROGUE_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("That {STR_VAR_1} was exactly what I needed. Thanks again!"))
    }
    else
    {
        msgbox(format("I'm running short on supplies. Could you spare one {STR_VAR_1}?pI can trade you a {STR_VAR_2} for it."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            special(RogueRouteEvents_TryCompleteSupplyRequest)
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
            {
                playfanfare(MUS_OBTAIN_ITEM)
                waitfanfare
                msgbox(format("Perfect! This should keep me going. Enjoy the {STR_VAR_2}!"))
            }
            elif(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_MISSING_ITEM)
            {
                msgbox(format("It doesn't look like you have a {STR_VAR_1} right now."))
            }
            else
            {
                msgbox(format("You'll need room in your Bag for the {STR_VAR_2} first."))
            }
        }
        else
        {
            msgbox(format("No worries. I'll be here if you change your mind."))
        }
    }

    release
}

script Rogue_RouteEvent_TrainerChallenge
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    buffertrainername(STR_VAR_1, VAR_0x8006)
    bufferitemname(STR_VAR_2, VAR_0x8004)

    if(var(VAR_ROGUE_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("That was a fine battle. Good luck farther along the route!"))
    }
    elif(var(VAR_ROGUE_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_REWARD_PENDING)
    {
        special(RogueRouteEvents_TryClaimTrainerReward)
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
        {
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare
            msgbox(format("Here's the {STR_VAR_2} I promised. You earned it!"))
        }
        else
        {
            msgbox(format("Make room for the {STR_VAR_2}, then come back for your prize."))
        }
    }
    else
    {
        msgbox(format("I'm {STR_VAR_1}. This clearing looks perfect for a quick challenge!pWin, and the {STR_VAR_2} is yours. Battle?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            special(RogueRouteEvents_BeginTrainerChallenge)
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
            {
                trainerbattle(TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT, VAR_ROGUE_SPECIAL_ENCOUNTER_DATA, 0, gPlaceholder_Trainer_PostBattleTaunt)
                special(RogueRouteEvents_FinishTrainerChallenge)
                if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
                {
                    playfanfare(MUS_OBTAIN_ITEM)
                    waitfanfare
                    msgbox(format("Excellent battle! Take this {STR_VAR_2}."))
                }
                else
                {
                    msgbox(format("Your Bag is full. Come back after making room for the {STR_VAR_2}."))
                }
            }
        }
        else
        {
            msgbox(format("Another time, then. The challenge stays open while you're on this route."))
        }
    }

    release
}

script Rogue_Common_SelectCuratedPokedex
{
    setvar(VAR_0x8009, POKEDEX_SELECTION_CURATED)
    call(Rogue_Common_SelectPokedex)
    return
}

script Rogue_Common_SelectTrialPokedex
{
    setvar(VAR_0x8009, POKEDEX_SELECTION_TRIAL)
    call(Rogue_Common_SelectPokedex)
    return
}

script Rogue_Common_SelectPokedex
{
    setvar(VAR_0x800A, MULTI_B_PRESSED)

    while(var(VAR_0x800A) == MULTI_B_PRESSED)
    {
        begindynamicmultichoice(24)
        if(var(VAR_0x8009) == POKEDEX_SELECTION_TRIAL)
        {
            special(RogueTrial_AppendPokedexOptions)
        }
        else
        {
            special(RoguePokedex_AppendCuratedOptions)
        }
        enddynamicmultichoice(1, 0, 5, TRUE)

        if(var(VAR_RESULT) == MULTI_B_PRESSED)
        {
            setvar(VAR_RESULT, NO)
            return
        }

        copyvar(VAR_0x8007, VAR_RESULT)
        if(var(VAR_0x8009) == POKEDEX_SELECTION_TRIAL)
        {
            special(RogueTrial_IsSelectedPokedexGroup)
        }
        else
        {
            special(RoguePokedex_IsSelectedCuratedGroup)
        }

        if(var(VAR_RESULT) == YES)
        {
            begindynamicmultichoice(16)
            if(var(VAR_0x8009) == POKEDEX_SELECTION_TRIAL)
            {
                special(RogueTrial_AppendSelectedPokedexGroupOptions)
            }
            else
            {
                special(RoguePokedex_AppendSelectedCuratedGroupOptions)
            }
            enddynamicmultichoice(1, 0, 5, TRUE)

            if(var(VAR_RESULT) == MULTI_B_PRESSED)
            {
                setvar(VAR_0x800A, MULTI_B_PRESSED)
            }
            else
            {
                copyvar(VAR_0x8006, VAR_RESULT)
                setvar(VAR_0x800A, YES)
            }
        }
        else
        {
            copyvar(VAR_0x8006, VAR_0x8007)
            setvar(VAR_0x800A, YES)
        }
    }

    setvar(VAR_RESULT, YES)
    return
}

script Rogue_GiveItem_Internal
{
    special(Rogue_DetermineItemPickupCount)
    finditem(VAR_ITEM_ID_VAL, VAR_ITEM_AMOUNT)
}

script Rogue_Common_DisplayPopups
{
    waitse
    waitfanfare
    closemessage
    special(Rogue_DisplayPopupsFromScript)
    waitstate
    return
}

script Rogue_Common_DisplaySkippablePopups
{
    waitse
    waitfanfare
    closemessage
    special(Rogue_DisplayPopupsFromScriptSkippable)
    waitstate
    return
}

script Rogue_Common_DisplayNewBadgePopup
{
    delay(10) // pause to let SE catch up
    call(Rogue_Common_DisplaySkippablePopups)
    
    delay(10) // pause to let SE catch up
    special(Popup_NewBadgeGet)
    call(Rogue_Common_DisplayPopups)
    return
}

script Rogue_Common_WaitForRogueAssistant
{
    special(Rogue_IsRogueAssistantConnected)
    if(var(VAR_RESULT) == NO)
    {
        callnative(ScriptMenu_ShowRogueAssistantNotice)

        message(format("Please connect Rogue Assistant… …\n{B_BUTTON} Cancel"))
        waitmessage

        callnative(Rogue_WaitForRogueAssistant)
        waitstate
        
        callnative(ScriptMenu_HideRogueAssistantNotice)

        call(Rogue_Common_DisplayPopups)
    }

    return
}

script RogueSafari_PurchaseSelectedMon
{
    copyvar(VAR_SAFARI_INDEX, VAR_SAFARI_SELECTED_INDEX)
    callnative(ScriptMenu_ShowSafariOfferDetails)
    waitstate

    if(var(VAR_RESULT) == SAFARI_SELECTED_BUY)
    {
        copyvar(VAR_SAFARI_INDEX, VAR_SAFARI_SELECTED_INDEX)
        special(Rogue_BufferSafariMonInfo)
        special(Rogue_TryPurchaseSafariMon)

        switch(var(VAR_RESULT))
        {
            case SAFARI_PURCHASE_TO_PARTY:
                msgbox(format("{STR_VAR_1} joined your party!"))

            case SAFARI_PURCHASE_TO_PC:
                bufferboxname(STR_VAR_3, VAR_PC_BOX_TO_SEND_MON)
                msgbox(format("{STR_VAR_1} was sent to {STR_VAR_3} in Pokémon Storage."))

            case SAFARI_PURCHASE_CANT_GIVE:
                msgbox(format("There isn't enough room in Pokémon Storage."))

            case SAFARI_PURCHASE_NOT_ENOUGH:
                copyvar(VAR_SAFARI_INDEX, VAR_SAFARI_SELECTED_INDEX)
                special(Rogue_BufferSafariMonMissingCostText)
                special(ShowFieldMessageStringVar4)
                waitmessage
                waitbuttonpress

            case SAFARI_PURCHASE_INVALID:
                msgbox(format("{STR_VAR_1} won't accept that offer."))
        }
    }

    if(var(VAR_RESULT) == SAFARI_SELECTED_DISMISS)
    {
        copyvar(VAR_SAFARI_INDEX, VAR_SAFARI_SELECTED_INDEX)
        special(Rogue_BufferSafariMonInfo)

        if(var(VAR_SAFARI_PURCHASE_CONTEXT) == SAFARI_PURCHASE_CONTEXT_CAVE)
        {
            msgbox(format("Dismiss {STR_VAR_1} from the Safari Cave?"), MSGBOX_YESNO)
        }
        else
        {
            msgbox(format("Dismiss {STR_VAR_1} from the Safari Area?"), MSGBOX_YESNO)
        }

        if(var(VAR_RESULT) == YES)
        {
            copyvar(VAR_SAFARI_INDEX, VAR_SAFARI_SELECTED_INDEX)
            special(Rogue_DismissSafariMon)

            if(var(VAR_RESULT) == YES)
            {
                if(var(VAR_SAFARI_PURCHASE_CONTEXT) == SAFARI_PURCHASE_CONTEXT_CAVE)
                {
                    msgbox(format("{STR_VAR_1} left the Safari Cave."))
                }
                else
                {
                    msgbox(format("{STR_VAR_1} left the Safari Area."))
                }

                special(ReloadWarpSilent)
            }
        }

        setvar(VAR_RESULT, SAFARI_SELECTED_BACK)
    }

    return
}

script Rogue_QuickSaveRun
{
    lockall

    msgbox(format("{COLOR RED}WARNING!\n{COLOR DARK_GRAY}You can only reload Quicksaves once.\pWhen the game next reloads, this Quicksave will be wiped."))

    special(Rogue_IsMultiplayerActive)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{COLOR RED}MULTIPLAYER WARNING!\n{COLOR DARK_GRAY}There is currently no method available to rejoin a Multiplayer Adventure outside of {POKEMON_HUB}.\pIf you Quicksave now, you will have to play the remainder of this Adventure single player."))
    }

    call(Common_EventScript_SaveGame)

    if(var(VAR_RESULT) == YES)
    {
        fadescreen(FADE_TO_BLACK)
        delay(60)
        special(DoSoftReset)
    }

    releaseall
}

script Rogue_QuickSaveLoad
{
    // We can accidentally call this on successful run return
    lockall

    if(var(VAR_0x8004) == TRUE)
    {
        msgbox(format("Adventure has been reloaded.\pClearing temporary save entry…"))

        call(Common_EventScript_ForceSaveGame)
    }
    else
    {
        msgbox(format("This save has already been reloaded.\pRetiring from Adventure…"))
        call(Rogue_ReturnToHub)
    }

    releaseall
}

script Rogue_QuickSaveVersionWarning
{
    lockall

    setvar(VAR_RESULT, YES)
    while(var(VAR_RESULT) == YES)
    {
        msgbox(format("{COLOR RED}WARNING!\n{COLOR DARK_GRAY}Invalid Save Location Detected!\pWhen upgrading to a new patch, make sure to save in {POKEMON_HUB}, outside of an Adventure.\pPlease revert to the older patch and re-save in a valid location."))
    }

    releaseall
}

script Rogue_QuickSaveVersionUpdateMessage
{
    bufferstring(STR_VAR_1, gText_RogueVersion)
    bufferstring(STR_VAR_2, gText_RogueVersionPrefix)
    bufferstring(STR_VAR_3, gText_RogueVersionSuffix)

    if(flag(FLAG_ROGUE_PRE_RELEASE_COMPAT_WARNING))
    {
        msgbox(format("WARNING!\pThis save game was detected to have come from a pre-release patch version.\pIt is not recommended to continue using this save, as you may lock yourself out of new content.\pPlease restore a backup if possible."))
    }

    msgbox(format("Welcome to...\nEmerald Rogue:\pDivergence {STR_VAR_2}!\p{STR_VAR_1} {STR_VAR_3}\pAlways remember to download from the official Divergence sources."), MSGBOX_DEFAULT)
    msgbox(format("I hope you enjoy Divergence!"), MSGBOX_DEFAULT)
}

script Rogue_Debug_SetWeather
{
    lock

    begindynamicmultichoice(24)
    appenddynamicmultichoice("None", WEATHER_NONE)
    appenddynamicmultichoice("Sunny", WEATHER_SUNNY)
    appenddynamicmultichoice("Drought", WEATHER_DROUGHT)
    appenddynamicmultichoice("Rain", WEATHER_RAIN)
    appenddynamicmultichoice("Rain Thunder", WEATHER_RAIN_THUNDERSTORM)
    appenddynamicmultichoice("Downpour", WEATHER_DOWNPOUR)
    appenddynamicmultichoice("Snow", WEATHER_SNOW)
    appenddynamicmultichoice("Sandstorm", WEATHER_SANDSTORM)
    appenddynamicmultichoice("Psychic Fog", WEATHER_PSYCHIC_FOG)
    appenddynamicmultichoice("Misty Fog", WEATHER_MISTY_FOG)
    appenddynamicmultichoice("Leaves", WEATHER_LEAVES)
    appenddynamicmultichoice("Eclipse", WEATHER_ECLIPSE)
    appenddynamicmultichoice("Acid Rain", WEATHER_ACID_RAIN)
    appenddynamicmultichoice("Plain Terrain", WEATHER_PLAIN_TERRAIN)
    appenddynamicmultichoice("Infested Terrain", WEATHER_INFESTED_TERRAIN)

    appenddynamicmultichoice("Sunny Clouds", WEATHER_SUNNY_CLOUDS)
    appenddynamicmultichoice("Volcanic Ash", WEATHER_VOLCANIC_ASH)
    appenddynamicmultichoice("Under Water", WEATHER_UNDERWATER)
    appenddynamicmultichoice("Under Water Bubbles", WEATHER_UNDERWATER_BUBBLES)
    appenddynamicmultichoice("Shade", WEATHER_SHADE)

    message(format("Which Weather?"))
    waitmessage
    enddynamicmultichoice(1, 0, 6, TRUE)

    if(var(VAR_RESULT) != MULTI_B_PRESSED)
    {
        setweather(VAR_RESULT)
        doweather
        setweather(VAR_RESULT)
        if(var(VAR_ROGUE_DESIRED_WEATHER) != WEATHER_NONE)
        {
            setweather(VAR_RESULT)
            doweather
        }
    }

    release
}

