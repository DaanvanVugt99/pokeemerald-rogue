        else
        {
            msgbox(format("That case? Finders keepers!\pYou want it back, come and take it!"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                special(RogueRouteEvents_BeginStolenTradeCaseBattle)
                if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
                {
                    trainerbattle(TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT, VAR_ROGUE_SPECIAL_ENCOUNTER_DATA, 0, gPlaceholder_Trainer_PostBattleTaunt)
                    special(RogueRouteEvents_FinishStolenTradeCaseBattle)
                    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
                    {
                        call(Rogue_Common_DisplayPopups)
                        msgbox(format("You recovered the merchant's {STR_VAR_2}."))
                    }
                    else
                    {
                        msgbox(format("You won, but there is no room in your Bag for the {STR_VAR_2}."))
                    }
                }
            }
            else
            {
                msgbox(format("Hah! Then keep your hands off our haul!"))
            }
        }
    }

    release
}

