script Rogue_RouteEvent_ForbiddenStonePayoff
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    bufferitemname(STR_VAR_1, ITEM_ABILITY_PATCH)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("The seal is quiet now. All 108 souls are at rest—for the moment."))
    }
    else
    {
        if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_REWARD_PENDING)
        {
            call(Rogue_RouteEvent_ForbiddenStoneGiveReward)
        }
        else
        {
            msgbox(format("The Odd Keystone is whole again.\pBut Spiritomb is fighting the seal. Will you help me bind it?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                special(RogueRouteEvents_PrepareForbiddenStoneBattle)
                if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
                {
                    playmoncry(SPECIES_SPIRITOMB, CRY_MODE_ENCOUNTER)
                    waitmoncry
                    special(BattleSetup_StartLegendaryBattle)
                    waitstate
                    specialvar(VAR_RESULT, GetBattleOutcome)
                    if(var(VAR_RESULT) == B_OUTCOME_WON)
                    {
                        msgbox(format("Spiritomb is drawn back into the Odd Keystone. The binding holds!"))
                        call(Rogue_RouteEvent_ForbiddenStoneGiveReward)
                    }
                    else
                    {
                        msgbox(format("The seal faltered, but the Odd Keystone is unharmed. We can try again."))
                    }
                }
                else
                {
                    msgbox(format("I cannot begin without the Odd Keystone. Please bring it back."))
                }
            }
            else
            {
                msgbox(format("Very well. The seal will endure a little longer."))
            }
        }
    }

    release
}

