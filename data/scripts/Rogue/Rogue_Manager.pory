script Rogue_RouteEvent_HexedShrine
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    bufferitemname(STR_VAR_2, VAR_0x8005)
    buffernumberstring(STR_VAR_1, VAR_0x8007)

    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("Our pact still binds you. Defeat the next Boss, and the {STR_VAR_2} will fade."))
    }
    else
    {
        msgbox(format("A small burden... for a handsome reward.\pTake the {STR_VAR_2}, and ¥{STR_VAR_1} is yours. The hex fades when the next Boss falls."))
        copyvar(VAR_0x8004, VAR_0x8005)
        callnative(ScriptMenu_ShowItemDescription)
        msgbox(format("Do we have a bargain?"), MSGBOX_YESNO)
        callnative(ScriptMenu_HideItemDescription)

        if(var(VAR_RESULT) == YES)
        {
            special(RogueRouteEvents_TryAcceptHexedShrine)
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
            {
                call(Rogue_Common_DisplayPopups)
                msgbox(format("Heh heh...\pThe price has taken hold. Defeat the next Boss, if you wish to be rid of it."))
            }
            else
            {
                if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_NO_SPACE)
                {
                    msgbox(format("Your Bag is too crowded for my little gift. Make room, then return."))
                }
                else
                {
                    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_MONEY_FULL)
                    {
                        msgbox(format("Your pockets are too heavy for every last coin. Spend some, then return."))
                    }
                    else
                    {
                        msgbox(format("Something spoils our bargain. Come back when you are ready."))
                    }
                }
            }
        }
        else
        {
            msgbox(format("Careful... Good sense can become a terrible habit."))
        }
    }

    release
}

