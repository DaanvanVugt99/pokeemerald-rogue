    {
        msgbox(format("Oh! This fossil is in wonderful shape!\pIt's a {STR_VAR_2}. If restored, it may become {STR_VAR_1}.\pA researcher up ahead can revive it. Will you take it?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            special(RogueRouteEvents_TryAcceptAnomalousFossilQuest)
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
            {
                call(Rogue_Common_DisplayPopups)
                msgbox(format("Please, take this.\pA researcher up ahead can revive it. And please, handle it carefully!"))
            }
            else
            {
                if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_NO_SPACE)
                {
