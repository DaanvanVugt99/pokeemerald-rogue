const VAR_ITEM_INDEX = VAR_0x8000
const VAR_ITEM_ID_VAL = VAR_0x8001
const VAR_ITEM_AMOUNT = VAR_0x8002
const VAR_SHOP_DIFFICULTY = VAR_0x8000
const VAR_SHOP_RANDOM_IDX = VAR_TEMP_F
const VAR_SAFARI_INDEX = VAR_0x8008
const VAR_SAFARI_SELECTED_INDEX = VAR_TEMP_A
const VAR_SAFARI_PURCHASE_CONTEXT = VAR_0x8000
const VAR_SAFARI_COST_COUNT = VAR_0x8004

const SAFARI_PURCHASE_CONTEXT_AREA = 0
const SAFARI_PURCHASE_CONTEXT_CAVE = 1

const SAFARI_PURCHASE_TO_PARTY = 0
const SAFARI_PURCHASE_TO_PC = 1
const SAFARI_PURCHASE_CANT_GIVE = 2
const SAFARI_PURCHASE_NOT_ENOUGH = 3
const SAFARI_PURCHASE_INVALID = 4

const SAFARI_SELECTED_BUY = 10
const SAFARI_SELECTED_DISMISS = 11
const SAFARI_SELECTED_BACK = 12

const ROGUE_ROUTE_EVENT_STATE_NOT_STARTED = 0
const ROGUE_ROUTE_EVENT_STATE_ACTIVE = 1
const ROGUE_ROUTE_EVENT_STATE_REWARD_PENDING = 2
const ROGUE_ROUTE_EVENT_STATE_COMPLETED = 3

const ROGUE_ROUTE_EVENT_RESULT_FAILED = 0
const ROGUE_ROUTE_EVENT_RESULT_SUCCESS = 1
const ROGUE_ROUTE_EVENT_RESULT_MISSING_ITEM = 2
const ROGUE_ROUTE_EVENT_RESULT_NO_SPACE = 3
const ROGUE_ROUTE_EVENT_RESULT_MONEY_FULL = 4
const ROGUE_ROUTE_EVENT_RESULT_CANT_GIVE_MON = 5
const ROGUE_ROUTE_EVENT_RESULT_PARTY_FULL = 6
const ROGUE_ROUTE_EVENT_RESULT_WRONG_MON = 7
const ROGUE_ROUTE_EVENT_RESULT_PROTECTED_MON = 8
const ROGUE_ROUTE_EVENT_RESULT_WRONG_SITE = 9
const ROGUE_ROUTE_EVENT_RESULT_ALREADY_DUG = 10
const VAR_ROUTE_EVENT_STATE = VAR_0x8008
const VAR_BURIED_CACHE_SITE_DUG = VAR_0x8003

const ROGUE_FOSSIL_RESTORATION_STABLE = 0
const ROGUE_FOSSIL_RESTORATION_ADAPTIVE = 1
const ROGUE_CAMP_COOK_CHOICE_HEAL = 0
const ROGUE_CAMP_COOK_CHOICE_BERRIES = 1
const ROGUE_CAMP_COOK_CHOICE_PP = 2

const POKEDEX_SELECTION_CURATED = 0
const POKEDEX_SELECTION_TRIAL = 1

// Re-used scripts
//

script Rogue_RouteEvent_Interact
{
    end
}

script Rogue_RouteEvent_Prop
{
    lock

    msgbox(format("Someone packed these supplies for a long road."))

    release
}

script Rogue_RouteEvent_BuriedCacheSupplies
{
    lock
    msgbox(format("A field journal, brushes, and measuring cord are arranged with practiced care."))
    release
}

script Rogue_RouteEvent_BuriedCacheArchaeologist
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    special(RogueRouteEvents_BufferBuriedCacheData)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("A remarkable find! The road keeps its history well hidden."))
    }
    else
    {
        if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_NOT_STARTED)
        {
            msgbox(format("I think there's something buried on this route.\pThe clue says: {STR_VAR_2}\pWould you help me dig it up?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                special(RogueRouteEvents_TryAcceptBuriedCache)
                if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
                {
                    call(Rogue_Common_DisplayPopups)
                    msgbox(format("Here, take this.\pCheck the landmarks carefully. Digging in the wrong spot might disturb a wild Pokémon."))
                }
                else
                {
                    msgbox(format("You need room among your Key Items for the Field Shovel. Nothing has changed yet."))
                }
            }
            else
            {
                msgbox(format("No harm done. The sites and my shovel will remain here while you decide."))
            }
        }
        else
        {
            msgbox(format("The clue says: {STR_VAR_2}\pCheck the landmarks carefully before you dig."))
        }
    }

    release
}

script Rogue_RouteEvent_BuriedCacheSite
{
    lock

    special(RogueRouteEvents_GetInteractionData)
    special(RogueRouteEvents_BufferBuriedCacheData)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("{STR_VAR_1}\pThe excavation is finished."))
        release
        end
    }
    if(var(VAR_BURIED_CACHE_SITE_DUG) == TRUE && var(VAR_ROUTE_EVENT_STATE) != ROGUE_ROUTE_EVENT_STATE_REWARD_PENDING)
    {
        msgbox(format("{STR_VAR_1}\pThis site has already been excavated."))
        release
        end
    }
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_NOT_STARTED)
    {
        msgbox(format("{STR_VAR_1}\pThe ground looks disturbed. You'll need the right tool to dig here."))
        release
        end
    }

    msgbox(format("{STR_VAR_1}\pThe clue says: {STR_VAR_2}\pDig here?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("You leave the ground untouched."))
        release
        end
    }

    special(RogueRouteEvents_TryDigBuriedCache)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        call(Rogue_Common_DisplayPopups)
        special(RogueRouteEvents_BufferBuriedCacheData)
        msgbox(format("The shovel strikes a sealed cache.\pType: {STR_VAR_3}\nIts contents survived the years intact!"))
    }
    else
    {
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_WRONG_SITE)
        {
            msgbox(format("The soil gives way, but there is no cache.\pA wild Pokémon was disturbed!"))
            playmoncry(VAR_0x8006, CRY_MODE_ENCOUNTER)
            waitmoncry
            special(BattleSetup_StartLegendaryBattle)
            waitstate
            specialvar(VAR_RESULT, GetBattleOutcome)
            if(var(VAR_RESULT) == B_OUTCOME_WON)
            {
                msgbox(format("The disturbed Pokémon retreats. The Field Shovel is unharmed; the other landmark is still worth checking."))
            }
        }
        else
        {
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_NO_SPACE)
            {
                msgbox(format("You uncover the cache, but your Bag cannot hold everything inside. The cache remains safely sealed."))
            }
            else
            {
                if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_MONEY_FULL)
                {
                    msgbox(format("You uncover the cache, but cannot carry every coin. The cache remains safely sealed."))
                }
                else
                {
                    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_ALREADY_DUG)
                    {
                        msgbox(format("This ground has already been searched."))
                    }
                    else
                    {
                        msgbox(format("Without the borrowed Field Shovel, the cache cannot be recovered safely."))
                    }
                }
            }
        }
    }

    release
}

script Rogue_RouteEvent_UnboundTutorProp
{
    lock

    msgbox(format("Every tool here is worn smooth. They've seen years of practice."))

    release
}

script Rogue_RouteEvent_UnboundTutor
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("That hidden technique is yours now.\pUse it well."))
    }
    else
    {
        special(RogueRouteEvents_PrepareUnboundTutor)
        if(var(VAR_RESULT) != ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
        {
            msgbox(format("Hm...\pI don't have a lesson for your Pokémon today."))
            release
            end
        }

        msgbox(format("I know a hidden technique that most Pokémon never get the chance to learn.\pI can teach any Pokémon {STR_VAR_1}, {STR_VAR_2}, or {STR_VAR_3}.\pBut only one lesson. Are you ready?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            setvar(VAR_0x8004, 0)
            setvar(VAR_0x8006, FALSE)
            special(TeachMoveFromContext)
            waitstate

            special(RogueRouteEvents_FinishUnboundTutor)
            if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
            {
                msgbox(format("Good. That technique should surprise your opponents."))
            }
            else
            {
                msgbox(format("Changed your mind? That's all right. I'll be here a while."))
            }
        }
        else
        {
            msgbox(format("No rush. A good technique is worth thinking over."))
        }
    }

    release
}

script Rogue_RouteEvent_CampCookProp
{
    lock

    msgbox(format("A cookfire crackles warmly. Something smells good."))

    release
}

script Rogue_RouteEvent_CampCook
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("The pot's empty now. Nothing better than a clean finish."))
        release
        end
    }

    msgbox(format("Hey, traveler! My stew's just about ready.\pA good meal can get a team back on its feet.\pWhat'll it be?"))
    begindynamicmultichoice(16)
    appenddynamicmultichoice("Full meal", ROGUE_CAMP_COOK_CHOICE_HEAL)
    appenddynamicmultichoice("Berry pack", ROGUE_CAMP_COOK_CHOICE_BERRIES)
    appenddynamicmultichoice("PP stew", ROGUE_CAMP_COOK_CHOICE_PP)
    appenddynamicmultichoice("No thanks", MULTI_B_PRESSED)
    enddynamicmultichoice(1, 0, 4, TRUE)

    if(var(VAR_RESULT) == ROGUE_CAMP_COOK_CHOICE_HEAL)
    {
        call(Rogue_RouteEvent_CampCookHeal)
    }
    elif(var(VAR_RESULT) == ROGUE_CAMP_COOK_CHOICE_BERRIES)
    {
        call(Rogue_RouteEvent_CampCookBerries)
    }
    elif(var(VAR_RESULT) == ROGUE_CAMP_COOK_CHOICE_PP)
    {
        call(Rogue_RouteEvent_CampCookPp)
    }
    else
    {
        msgbox(format("No problem. The fire's warm if you need a quick rest."))
    }

    release
}

script Rogue_RouteEvent_CampCookHeal
{
    msgbox(format("Then gather your Pokémon around the fire."))
    call(Common_EventScript_OutOfCenterPartyHeal)
    special(RogueRouteEvents_TryCampCookHealParty)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        msgbox(format("There we go! Everyone looks bright-eyed again."))
    }
    else
    {
        msgbox(format("Hm... The meal isn't coming together. Give me a moment."))
    }

    return
}

script Rogue_RouteEvent_CampCookBerries
{
    msgbox(format("I packed a few Berries for the road. Take them with you."))
    special(RogueRouteEvents_TryCampCookGiveBerries)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        call(Rogue_Common_DisplayPopups)
        msgbox(format("Those should come in handy between battles."))
    }
    else
    {
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_NO_SPACE)
        {
            msgbox(format("Your Bag's packed tight. Make a little room and come back."))
        }
        else
        {
            msgbox(format("Hm... The meal isn't coming together. Give me a moment."))
        }
    }

    return
}

script Rogue_RouteEvent_CampCookPp
{
    msgbox(format("This recipe wakes up a Pokémon's moves.\pWhich Pokémon should have some?"))
    special(ChoosePartyMon)
    waitstate
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
    {
        msgbox(format("Changed your mind? That's fine. Best not to waste a good bowl."))
        return
    }

    bufferpartymonnick(STR_VAR_1, VAR_0x8004)
    special(RogueRouteEvents_TryCampCookMaxPp)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        msgbox(format("{STR_VAR_1} looks ready to give every move its all."))
    }
    else
    {
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_WRONG_MON)
        {
            msgbox(format("That Egg should stay warm, but it can't eat this yet."))
        }
        else
        {
            msgbox(format("Hm... The meal isn't coming together. Give me a moment."))
        }
    }

    return
}

script Rogue_RouteEvent_MysteryEggCourierProp
{
    lock

    msgbox(format("A small carrier bag has been packed with extra care."))

    release
}

script Rogue_RouteEvent_MysteryEggCourier
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    bufferspeciesname(STR_VAR_1, VAR_0x8005)
    bufferitemname(STR_VAR_2, VAR_0x8004)

    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_ACTIVE)
    {
        msgbox(format("Please bring that Egg to the Day Care Lady at a rest stop.\pShe'll know how to keep it safe."))
        release
        end
    }

    msgbox(format("Hello there. I found a Pokémon Egg near this route.\pIt may hatch into {STR_VAR_1}, but it needs a safer place than the road.\pCould you carry it to the Day Care Lady at a rest stop?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("I understand. An Egg needs a careful Trainer."))
        release
        end
    }

    call(Rogue_RouteEvent_MysteryEggCourierTryAccept)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        call(Rogue_Common_DisplayPopups)
        msgbox(format("Thank you. Please keep it with your team until you reach the Day Care Lady."))
    }
    elif(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_CANT_GIVE_MON)
    {
        msgbox(format("Oh... It looks like this Egg can't travel with your team right now."))
    }
    else
    {
        msgbox(format("Something isn't right. I'll keep the Egg warm for now."))
    }

    release
}

script Rogue_RouteEvent_MysteryEggCourierTryAccept
{
    setvar(VAR_0x8006, PARTY_NOTHING_CHOSEN)
    special(RogueRouteEvents_TryAcceptMysteryEggCourierQuest)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_PARTY_FULL)
    {
        msgbox(format("Your party is full. One Pokémon will have to be released before you can carry the Egg. Make room?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("That's all right. The Egg can wait here a little longer."))
            return
        }

        special(ChoosePartyMon)
        waitstate
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            msgbox(format("Changed your mind? That's fine. No Pokémon was released."))
            return
        }

        copyvar(VAR_0x8006, VAR_0x8004)
        bufferpartymonnick(STR_VAR_1, VAR_0x8006)
        msgbox(format("Release {STR_VAR_1} and carry the Egg?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("We'll leave your team as it is. No Pokémon was released."))
            return
        }

        if(var(VAR_0x8006) == 0)
        {
            call(Rogue_ScriptHideFollower)
        }
        special(RogueRouteEvents_TryAcceptMysteryEggCourierQuest)
        copyvar(VAR_0x8007, VAR_RESULT)
        if(var(VAR_0x8006) == 0)
        {
            call(Rogue_ScriptShowFollower)
        }
        copyvar(VAR_RESULT, VAR_0x8007)
    }

    return
}

script Rogue_RouteEvent_TravelingMerchant
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    message(format("Welcome!\pMy stock changes from place to place, but everything is half price.\pBuying or selling?"))
    waitmessage

    rogue_dynamicpokemart(VAR_0x8007)
    special(RogueRouteEvents_FinishTravelingMerchant)

    msgbox(format("Much obliged!\pI'll be here until you move on."))
    release
}

