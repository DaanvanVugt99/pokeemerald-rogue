        {
            msgbox(format("The last soul sank into the stone.\pAll 108 souls are together once more."))
        }
        else
        {
            msgbox(format("The soul sank into the stone.\pThe Odd Keystone now holds {STR_VAR_1} of the three missing souls."))
        }
        removeobject(VAR_LAST_TALKED)
    }
    else
    {
        msgbox(format("The soul slips from your grasp. Without the Odd Keystone, it cannot be bound."))
    }

