script Rogue_EventScript_AttemptSnagBattle
{
    lock

    clearflag(FLAG_ROGUE_IN_SNAG_BATTLE)
    msgbox(format("Would you like to try to snag the {STR_VAR_1}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
