script Rogue_RouteEvent_FieldRepairPart
{
    lock

    special(RogueRouteEvents_GetInteractionData)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("Nothing else was left behind."))
    }
    else
    {
        special(RogueRouteEvents_CollectFieldRepairPart)
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
        {
            msgbox(format("You found a machine part."))
        }
        else
        {
            msgbox(format("There's nothing useful here now."))
        }
    }

    release
}

script Rogue_RouteEvent_FieldRepairBench
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    special(RogueRouteEvents_BufferFieldRepairBenchData)

    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("The modulator is spent, but that tune-up should hold for the rest of your run."))
        release
        end
    }

    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_NOT_STARTED)
    {
        msgbox(format("Ah, just my luck!\pI lost three machine parts nearby.\pBring them back and I can tune one Pokémon's Ability. Could you help?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Fair enough. I'll keep looking before the parts get kicked farther off the road."))
            release
            end
        }

        special(RogueRouteEvents_TryAcceptFieldRepairBenchQuest)
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
        {
            msgbox(format("Thanks. There should be three parts in all.\pIf you spot anything shiny, bring it here."))
        }
        else
        {
            msgbox(format("Hm... The modulator isn't responding. Give me a moment to check the wiring."))
        }

        release
        end
    }

    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_ACTIVE)
    {
        buffernumberstring(STR_VAR_2, VAR_0x8007)
        msgbox(format("I still need all three parts before I can start.\pRecovered: {STR_VAR_2}/3"))
        release
        end
    }

    msgbox(format("That's every part!\pLet's see what the modulator can do..."))
    special(RogueRouteEvents_BufferFieldRepairBenchData)
    if(var(VAR_0x8009) == FALSE)
    {
        msgbox(format("Oh... It stabilized as {STR_VAR_1}, but none of your current Pokémon can use that tune-up.\pBring me a compatible Pokémon and I'll keep the machine ready."))
        release
        end
    }

    msgbox(format("It stabilized as {STR_VAR_1}.\pWhich Pokémon should receive that Ability?"))
    special(ChoosePartyMon)
    waitstate
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
    {
        msgbox(format("No problem. The machine is ready when you are."))
        release
        end
    }

    copyvar(VAR_0x8006, VAR_0x8004)
    bufferpartymonnick(STR_VAR_2, VAR_0x8006)
    msgbox(format("Tune {STR_VAR_2}'s Ability to {STR_VAR_1}?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Careful choice. The modulator only has one good pulse in it."))
        release
        end
    }

    special(RogueRouteEvents_TryApplyFieldRepairAbility)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        msgbox(format("{STR_VAR_2}'s Ability became {STR_VAR_1}!"))
    }
    elif(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_WRONG_MON)
    {
        msgbox(format("That Pokémon won't respond to this tune-up. Choose another one."))
    }
    else
    {
        msgbox(format("The modulator cut out. I can try again once it settles."))
    }

    release
}

script Rogue_RouteEvent_TideSalvage
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    bufferitemname(STR_VAR_1, VAR_0x8004)

    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("That was the only thing I saw drifting by. The tide's quiet now."))
        release
        end
    }

    msgbox(format("Hey! Something's caught in the current!\pI can see {STR_VAR_1} in there.\pWill you help me pull it in?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("No worries. I'll keep an eye on it a little longer."))
        release
        end
    }

    special(RogueRouteEvents_TryClaimTideSalvage)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        call(Rogue_Common_DisplayPopups)
        msgbox(format("Nice work!\pWe got it before the current carried it off."))
    }
    else
    {
        if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_NO_SPACE)
        {
            msgbox(format("Your Bag's too full to keep it safe. Make some room and we'll try again."))
        }
        else
        {
            msgbox(format("The current's fighting us. Let's try again in a moment."))
        }
    }

    release
}

script Rogue_RouteEvent_BreedersExchangePokemon
{
    lock
    faceplayer
    special(RogueRouteEvents_ShowBreedersExchangePreview)
    waitstate
    release
}

script Rogue_RouteEvent_BreedersExchange
{
    lock
    faceplayer

    special(RogueRouteEvents_GetInteractionData)
    bufferspeciesname(STR_VAR_1, VAR_0x8004)
    bufferspeciesname(STR_VAR_2, VAR_0x8005)
    if(var(VAR_ROUTE_EVENT_STATE) == ROGUE_ROUTE_EVENT_STATE_COMPLETED)
    {
        msgbox(format("Please take good care of {STR_VAR_1}!"))
        release
        end
    }

    msgbox(format("Hi! I'm a Pokémon Breeder.\pI'm looking for {STR_VAR_2} from this route."))
    msgbox(format("If you have one, would you like to trade it for my {STR_VAR_1}?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Oh, well... Come back if you change your mind."))
        release
        end
    }

    special(ChoosePartyMon)
    waitstate
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
    {
        msgbox(format("Changed your mind? That's all right. Nothing has changed hands."))
        release
        end
    }

    copyvar(VAR_0x8006, VAR_0x8004)
    special(RogueRouteEvents_ValidateBreedersExchangeSelection)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_WRONG_MON)
    {
        bufferspeciesname(STR_VAR_1, VAR_0x8005)
        msgbox(format("Sorry, I'm looking for {STR_VAR_1} from this route."))
        release
        end
    }
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_PROTECTED_MON)
    {
        msgbox(format("That Pokémon seems tied to something important. Better keep it with you."))
        release
        end
    }
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_NO_SPACE)
    {
        msgbox(format("Your Pokémon is carrying something, but your Bag has no room for it. Make a little space first."))
        release
        end
    }
    if(var(VAR_RESULT) != ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        msgbox(format("Hmm... Something about that trade doesn't feel right. Let's leave it be."))
        release
        end
    }

    bufferpartymonnick(STR_VAR_1, VAR_0x8006)
    bufferspeciesname(STR_VAR_2, VAR_0x8004)
    msgbox(format("Trade {STR_VAR_1} for {STR_VAR_2}? This can't be undone."), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("All right. Both Pokémon stay right where they are."))
        release
        end
    }

    special(RogueRouteEvents_TryCompleteBreedersExchange)
    if(var(VAR_RESULT) == ROGUE_ROUTE_EVENT_RESULT_SUCCESS)
    {
        call(Rogue_Common_DisplayPopups)
        special(RogueRouteEvents_GetInteractionData)
        bufferspeciesname(STR_VAR_1, VAR_0x8004)
        msgbox(format("Thanks! Please take good care of {STR_VAR_1}!"))
    }
    else
    {
        msgbox(format("Oh? The trade couldn't be completed."))
    }

    release
}

script Rogue_RouteEvent_HexedShrineProp
{
    lock

    msgbox(format("The air around the stone bites with unnatural cold."))

