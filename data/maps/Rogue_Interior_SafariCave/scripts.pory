const VAR_SHAKE_VERTICAL_PAN = VAR_0x8004
const VAR_SHAKE_HORIZONTAL_PAN = VAR_0x8005
const VAR_SHAKE_NUM_SHAKES = VAR_0x8006
const VAR_SHAKE_SHAKE_DELAY = VAR_0x8007

const VAR_SAFARI_SELECTED_INDEX = VAR_TEMP_A
const VAR_SAFARI_PURCHASE_CONTEXT = VAR_0x8000
const SAFARI_PURCHASE_CONTEXT_CAVE = 1
const SAFARI_SELECTED_BACK = 12

mapscripts Rogue_Interior_SafariCave_MapScripts {}

script Rogue_Interior_SafariCave_InteractLegendSummon
{
    lock

    msgbox(format("It's an odd statue…"))

    special(Rogue_AnyLegendsInSafari)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Powerful Pokémon cries echo throughout the cave.\p{POKEBLOCK} can be offered in order to bring one of these Pokémon with you."))

        begindynamicmultichoice
        appenddynamicmultichoice("View Pokémon", 0)
        appenddynamicmultichoice("Dismiss All", 1)
        appenddynamicmultichoice("Exit", MULTI_B_PRESSED)
        enddynamicmultichoice(1, 0, 3, TRUE)

        switch(var(VAR_RESULT))
        {
            case 0:
                msgbox(format("Which Pokémon would you like to make an offering to?"))

                setvar(VAR_RESULT, SAFARI_SELECTED_BACK)
                while(var(VAR_RESULT) == SAFARI_SELECTED_BACK)
                {
                    special(RogueSafari_CompactEmptyEntries)
                    special(Special_SelectSafariMonInPokedex)
                    waitstate

                    if(var(VAR_RESULT) != ROGUE_SAFARI_TOTAL_MONS)
                    {
                        copyvar(VAR_SAFARI_SELECTED_INDEX, VAR_RESULT)
                        setvar(VAR_SAFARI_PURCHASE_CONTEXT, SAFARI_PURCHASE_CONTEXT_CAVE)
                        call(RogueSafari_PurchaseSelectedMon)
                    }
                }

            case 1:
                msgbox(format("This will dismiss any Pokémon currently resting in the Safari Cave.\pAre you sure you want to do this?"), MSGBOX_YESNO)

                if(var(VAR_RESULT) == YES)
                {
                    special(RogueSafari_ResetAllLegendEntries)
                    special(ReloadWarpSilent)
                }
        }
    }
    else
    {
        msgbox(format("The cave is silent…"))
    }

    release
}

script Rogue_Interior_SafariCave_BattleSummonMon
{
    fadeoutbgm(1)

    playbgm(MUS_NONE, FALSE)
    delay(60)

    setvar(VAR_SHAKE_VERTICAL_PAN, 1)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 1)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    playbgm(MUS_DP_LEGEND_APPEARS, FALSE)
    
    delay(60)
    setvar(VAR_SHAKE_VERTICAL_PAN, -2)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 2)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    delay(60)
    setvar(VAR_SHAKE_VERTICAL_PAN, 3)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    delay(60)
    setvar(VAR_SHAKE_VERTICAL_PAN, -4)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    delay(90)
    setvar(VAR_SHAKE_VERTICAL_PAN, 5)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 5)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    //waitstate

    playmoncry(VAR_RESULT, CRY_MODE_ENCOUNTER)
    msgbox(format("!!!"))

    waitmoncry

    seteventmon(VAR_RESULT, 1, ITEMS_COUNT, FALSE)
    special(BattleSetup_StartWildBattle)
    waitstate
    return
}
