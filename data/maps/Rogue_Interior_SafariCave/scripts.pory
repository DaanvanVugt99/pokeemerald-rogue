const VAR_SHAKE_VERTICAL_PAN = VAR_0x8004
const VAR_SHAKE_HORIZONTAL_PAN = VAR_0x8005
const VAR_SHAKE_NUM_SHAKES = VAR_0x8006
const VAR_SHAKE_SHAKE_DELAY = VAR_0x8007

const VAR_SAFARI_INDEX = VAR_0x8008
const VAR_SAFARI_COST_COUNT = VAR_0x8004
const VAR_SAFARI_COST_ITEM_0 = VAR_0x8005
const VAR_SAFARI_COST_COUNT_0 = VAR_0x8006
const VAR_SAFARI_COST_ITEM_1 = VAR_0x8007
const VAR_SAFARI_COST_COUNT_1 = VAR_0x8009
const VAR_SAFARI_COST_ITEM_2 = VAR_0x800A
const VAR_SAFARI_COST_COUNT_2 = VAR_0x800B

const SAFARI_PURCHASE_TO_PARTY = 0
const SAFARI_PURCHASE_TO_PC = 1
const SAFARI_PURCHASE_CANT_GIVE = 2
const SAFARI_PURCHASE_NOT_ENOUGH = 3
const SAFARI_PURCHASE_INVALID = 4

const SAFARI_SELECTED_BUY = 10
const SAFARI_SELECTED_DISMISS = 11

mapscripts Rogue_Interior_SafariCave_MapScripts {}

script Rogue_Interior_SafariCave_InteractLegendSummon
{
    lock

    msgbox(format("It's an odd statue…"))

    special(Rogue_AnyLegendsInSafari)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Powerful Pokémon cries echo throughout the cave.\p{POKEBLOCK} can be offered in order to bring one of these Pokémon with you."))

        begindynamicmultichoice
        appenddynamicmultichoice("Make Offering", 0)
        appenddynamicmultichoice("Dismiss Pokémon", 1)
        appenddynamicmultichoice("Exit", MULTI_B_PRESSED)
        enddynamicmultichoice(1, 0, 3, TRUE)

        switch(var(VAR_RESULT))
        {
            case 0:
                msgbox(format("Which Pokémon would you like to make an offering to?"))

                special(RogueSafari_CompactEmptyEntries)
                special(Special_SelectSafariMonInPokedex)
                waitstate

                if(var(VAR_RESULT) != ROGUE_SAFARI_TOTAL_MONS)
                {
                    copyvar(VAR_SAFARI_INDEX, VAR_RESULT)
                    call(Rogue_Interior_SafariCave_PurchaseSelectedMon)
                }

            case 1:
                msgbox(format("This will dismiss any Pokémon currently resting in the Safari Cave.\pAre you sure you want to do this?"), MSGBOX_YESNO)

                if(var(VAR_RESULT) == YES)
                {
                    special(RogueSafari_ResetAllLegendEntries)
                    special(ReloadWarpSilent)
                }
        }
    }
    else
    {
        msgbox(format("The cave is silent…"))
    }

    release
}

script Rogue_Interior_SafariCave_PurchaseSelectedMon
{
    special(Rogue_BufferSafariMonInfo)
    special(Rogue_BufferSafariMonPurchaseCost)
    setvar(VAR_RESULT, MULTI_B_PRESSED)

    switch(var(VAR_SAFARI_COST_COUNT))
    {
        case 1:
            bufferitemnameplural(STR_VAR_1, VAR_SAFARI_COST_ITEM_0, VAR_SAFARI_COST_COUNT_0)
            msgbox(format("This Pokémon wants {STR_VAR_1}."))

        case 2:
            bufferitemnameplural(STR_VAR_1, VAR_SAFARI_COST_ITEM_0, VAR_SAFARI_COST_COUNT_0)
            bufferitemnameplural(STR_VAR_2, VAR_SAFARI_COST_ITEM_1, VAR_SAFARI_COST_COUNT_1)
            msgbox(format("This Pokémon wants {STR_VAR_1}\nand {STR_VAR_2}."))

        case 3:
            bufferitemnameplural(STR_VAR_1, VAR_SAFARI_COST_ITEM_0, VAR_SAFARI_COST_COUNT_0)
            bufferitemnameplural(STR_VAR_2, VAR_SAFARI_COST_ITEM_1, VAR_SAFARI_COST_COUNT_1)
            bufferitemnameplural(STR_VAR_3, VAR_SAFARI_COST_ITEM_2, VAR_SAFARI_COST_COUNT_2)
            msgbox(format("This Pokémon wants {STR_VAR_1},\n{STR_VAR_2}, and {STR_VAR_3}."))
    }

    if(var(VAR_SAFARI_COST_COUNT) != 0)
    {
        begindynamicmultichoice
        appenddynamicmultichoice("Make Offering", SAFARI_SELECTED_BUY)
        appenddynamicmultichoice("Dismiss {PKMN}", SAFARI_SELECTED_DISMISS)
        appenddynamicmultichoice("Cancel", MULTI_B_PRESSED)
        enddynamicmultichoice(1, 0, 3, TRUE)
    }

    if(var(VAR_RESULT) == SAFARI_SELECTED_BUY)
    {
        special(Rogue_BufferSafariMonInfo)
        special(Rogue_TryPurchaseSafariMon)

        switch(var(VAR_RESULT))
        {
            case SAFARI_PURCHASE_TO_PARTY:
                msgbox(format("{STR_VAR_1} joined your party!"))

            case SAFARI_PURCHASE_TO_PC:
                bufferboxname(STR_VAR_3, VAR_PC_BOX_TO_SEND_MON)
                msgbox(format("{STR_VAR_1} was sent to {STR_VAR_3} in Pokémon Storage."))

            case SAFARI_PURCHASE_CANT_GIVE:
                msgbox(format("There isn't enough room in Pokémon Storage."))

            case SAFARI_PURCHASE_NOT_ENOUGH:
                msgbox(format("You don't have enough {POKEBLOCK}."))

            case SAFARI_PURCHASE_INVALID:
                msgbox(format("{STR_VAR_1} won't accept that offer."))
        }
    }

    if(var(VAR_SAFARI_COST_COUNT) == 0)
    {
        special(Rogue_BufferSafariMonInfo)
        msgbox(format("{STR_VAR_1} won't accept any available {POKEBLOCK}."))

        begindynamicmultichoice
        appenddynamicmultichoice("Dismiss {PKMN}", SAFARI_SELECTED_DISMISS)
        appenddynamicmultichoice("Cancel", MULTI_B_PRESSED)
        enddynamicmultichoice(1, 0, 2, TRUE)
    }

    if(var(VAR_RESULT) == SAFARI_SELECTED_DISMISS)
    {
        special(Rogue_BufferSafariMonInfo)
        msgbox(format("Dismiss {STR_VAR_1} from the Safari Cave?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            special(Rogue_DismissSafariMon)

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("{STR_VAR_1} left the Safari Cave."))
                special(ReloadWarpSilent)
            }
        }
    }
}

script Rogue_Interior_SafariCave_BattleSummonMon
{
    fadeoutbgm(1)

    playbgm(MUS_NONE, FALSE)
    delay(60)

    setvar(VAR_SHAKE_VERTICAL_PAN, 1)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 1)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    playbgm(MUS_DP_LEGEND_APPEARS, FALSE)
    
    delay(60)
    setvar(VAR_SHAKE_VERTICAL_PAN, -2)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 2)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    delay(60)
    setvar(VAR_SHAKE_VERTICAL_PAN, 3)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 3)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    delay(60)
    setvar(VAR_SHAKE_VERTICAL_PAN, -4)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 4)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    waitstate

    delay(90)
    setvar(VAR_SHAKE_VERTICAL_PAN, 5)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 5)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 5)
    special(ShakeCamera)
    //waitstate

    playmoncry(VAR_RESULT, CRY_MODE_ENCOUNTER)
    msgbox(format("!!!"))

    waitmoncry

    seteventmon(VAR_RESULT, 1, ITEMS_COUNT, FALSE)
    special(BattleSetup_StartWildBattle)
    waitstate
    return
}
