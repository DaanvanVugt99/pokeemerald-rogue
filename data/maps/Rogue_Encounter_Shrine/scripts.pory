mapscripts Rogue_Encounter_Shrine_MapScripts {}


script Rogue_Encounter_Shrine_Talk
{
    lock
    faceplayer
    bufferitemname(STR_VAR_1, ITEM_SACRED_ASH)

    specialvar(VAR_RESULT, Rogue_HasChallengedShrine)
    if(var(VAR_RESULT) == TRUE)
    {
        checkitem(ITEM_SACRED_ASH)
        if(var(VAR_RESULT) == TRUE)
        {
            msgbox(format("May that {STR_VAR_1} light your way when all other hope is lost."))
        }
        else
        {
            msgbox(format("The rainbow guardian answers each challenger only once."))
        }
    }
    else
    {
        msgbox(format("Why hello!\nWhat a treat to have visitors!"))

        message(format("A sacred guardian watches over this shrine.\pThose who overcome its trial are entrusted with {STR_VAR_1}."))
        setvar(VAR_TEMP_0, TRUE)

        while(var(VAR_TEMP_0) == TRUE)
        {
            setvar(VAR_TEMP_0, FALSE)
            waitmessage

            multichoice(20, 6, MULTI_YESNOINFO, NO)

            switch(var(VAR_RESULT))
            {
                case 0: // Yes
                    call(Rogue_Encounter_Shrine_Challenge)

                case 1: // No
                case MULTI_B_PRESSED:
                    msgbox(format("I see…\nIf you change your mind, please do let me know."), MSGBOX_DEFAULT)

                case 2: // Info
                    msgbox(format("The guardian is Ho-Oh. The colours of the rainbow may grant it a different type.\pIts moves and Ability may not be what you expect."), MSGBOX_DEFAULT)
                    msgbox(format("{STR_VAR_1} automatically revives and heals your party after a whiteout, allowing your Adventure to continue.\pIt crumbles after use. The trial may only be attempted once."), MSGBOX_DEFAULT)
                    setvar(VAR_TEMP_0, TRUE)
                    message(format("Will you challenge the guardian?"))
            }
        }
    }

    release
}

script Rogue_Encounter_Shrine_Challenge
{
    checkitemspace(ITEM_SACRED_ASH)

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Oh…\nIt looks like your bag is too full.\pMake room before you undertake the trial."))
    }
    else
    {
        msgbox(format("Then step forward and let the rainbow judge your resolve!"))

        special(Rogue_PrepareShrineChallenge)
        playmoncry(SPECIES_HO_OH, CRY_MODE_ENCOUNTER)
        waitmoncry

        special(BattleSetup_StartShrineBattle)
        waitstate

        specialvar(VAR_RESULT, GetBattleOutcome)
        if(var(VAR_RESULT) == B_OUTCOME_WON)
        {
            bufferitemname(STR_VAR_1, ITEM_SACRED_ASH)
            msgbox(format("Magnificent!\pHo-Oh has acknowledged your strength. Please accept this {STR_VAR_1}."))

            giveitem(ITEM_SACRED_ASH)
            call(Rogue_Common_DisplayPopups)
            quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)
        }
        else
        {
            msgbox(format("The guardian has withdrawn.\pIts trial cannot be called upon again during this Adventure."))
        }
    }
}
