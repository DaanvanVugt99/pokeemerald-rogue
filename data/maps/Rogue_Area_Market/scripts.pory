script Rogue_Area_Market_CraftPokeblock
{
    lock

    msgbox(format("Hello!\nI can help you craft {POKEBLOCK} from Berries.\pMost {POKEBLOCK} cost 5 matching Berries each."))

    setvar(VAR_0x8009, YES)
    while(var(VAR_0x8009) == YES)
    {
        begindynamicmultichoice
        appenddynamicmultichoice("Type Blocks", 0)
        appenddynamicmultichoice("Stat Blocks", 1)
        appenddynamicmultichoice("Shiny Block", 2)
        appenddynamicmultichoice("Exit", MULTI_B_PRESSED)

        message(format("What would you like to craft?"))
        waitmessage
        enddynamicmultichoice(19, 2, 4, TRUE)

        switch(var(VAR_RESULT))
        {
            case 0:
                call(Rogue_Area_Market_CraftTypePokeblock)

            case 1:
                call(Rogue_Area_Market_CraftStatPokeblock)

            case 2:
                call(Rogue_Area_Market_CraftShinyPokeblock)

            case MULTI_B_PRESSED:
                setvar(VAR_0x8009, NO)
        }
    }

    msgbox(format("Please let me know if you'd like to craft anything else!"))
    release
}

script Rogue_Area_Market_CraftTypePokeblock
{
    message(format("Which type of {POKEBLOCK} would you like?"))
    waitmessage
    rogue_custompokemart_recipes(PokeblockTypeRecipes)
}

script Rogue_Area_Market_CraftStatPokeblock
{
    message(format("Which stat {POKEBLOCK} would you like?"))
    waitmessage
    rogue_custompokemart_recipes(PokeblockStatRecipes)
}

script Rogue_Area_Market_CraftShinyPokeblock
{
    message(format("Shiny {POKEBLOCK} can be crafted with Starf Berries."))
    waitmessage
    rogue_custompokemart_recipes(PokeblockShinyRecipes)
}

script Rogue_Area_Market_TalkPokeblockCrafting
{
    lock
    msgbox(format("They're carefully sorting Berries for {POKEBLOCK} crafting."))
    release
}

script Rogue_Area_Market_TalkPokeblockHelper
{
    lock
    faceplayer
    msgbox(format("You look like a Trainer to me!\pI'm something of a {POKEBLOCK} Expert myself.\pI can help you learn which Berries make what kinds of {POKEBLOCK}, if you'd like."))

    setvar(VAR_RESULT, YES)

    while(var(VAR_RESULT) == YES)
    {
        begindynamicmultichoice(32)
        special(Rogue_AppendMultichoicePokeblockItems)
        message(format("Which type of {POKEBLOCK} are you interested in?"))
        waitmessage
        enddynamicmultichoice(19, 2, 5, TRUE)

        if(var(VAR_RESULT) != MULTI_B_PRESSED)
        {
            copyvar(VAR_0x8004, VAR_RESULT)
            addvar(VAR_0x8004, FIRST_ITEM_POKEBLOCK)
            bufferitemname(STR_VAR_1, VAR_0x8004)

            begindynamicmultichoice(32)
            special(Rogue_AppendMultichoiceBerriesForPokeblock)
            message(format("These are the Berries which produce {STR_VAR_1}."))
            waitmessage
            enddynamicmultichoice(19, 2, 5, TRUE)
            
            setvar(VAR_RESULT, YES)
        }
        else
        {
            setvar(VAR_RESULT, NO)
        }
    }

    release
}
