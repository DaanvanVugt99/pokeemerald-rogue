
const FLAG_HIDE_BANK = FLAG_TEMP_1
const FLAG_HIDE_TREATS = FLAG_TEMP_2
const FLAG_HIDE_CHEFS = FLAG_TEMP_3
const FLAG_HIDE_PIE = FLAG_TEMP_4

const VAR_CRUST_ITEM = VAR_0x8008
const VAR_FILLING_ITEM = VAR_0x8009
const VAR_PIE_SIZE = VAR_0x800A
const VAR_FILLING_AMOUNT = VAR_0x800B

const NPC_OBJ_NORMAL_CHEF = 7
const NPC_OBJ_SHINY_CHEF = 8
const NPC_OBJ_PLACED_PIE = 9

mapscripts Rogue_Area_Market_MapScripts
{
    MAP_SCRIPT_ON_LOAD: Rogue_Area_Market_OnMapLoad
}


script Rogue_Area_Market_OnMapLoad
{
    hubupgradeunlocked(HUB_UPGRADE_MARKET_BANK)
    if(var(VAR_RESULT) == YES)
    {
        clearflag(FLAG_HIDE_BANK)
    }
    else
    {
        setflag(FLAG_HIDE_BANK)
    }

    hubupgradeunlocked(HUB_UPGRADE_MARKET_TREAT_SHOP)
    if(var(VAR_RESULT) == TRUE)
    {
        clearflag(FLAG_HIDE_TREATS)
    }
    else
    {
        setflag(FLAG_HIDE_TREATS)
    }

    hubupgradeunlocked(HUB_UPGRADE_MARKET_BAKERY)
    if(var(VAR_RESULT) == YES)
    {
        clearflag(FLAG_HIDE_CHEFS)
    }
    else
    {
        setflag(FLAG_HIDE_CHEFS)
    }

    setflag(FLAG_HIDE_PIE)
}



script Rogue_Area_Market_ShopBank
{
    lock
    faceplayer
    msgbox(format("Welcome to the Bank!\pI manage your ADVENTURE FUND, which sets how much money you start each Adventure with."), MSGBOX_DEFAULT)
    call(RogueHub_Bank_OfferNextUpgrade)
    release
}

script Rogue_Area_Market_BankSign
{
    hubupgradeunlocked(HUB_UPGRADE_MARKET_BANK)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Bank\pUpgrade the starting funds for your Adventures."), MSGBOX_SIGN)
    }
    else
    {
        msgbox(format("Bank\nClosed until the Bank upgrade."), MSGBOX_SIGN)
    }
}

script Rogue_Market_CraftSign
{
    msgbox(format("{POKEBLOCK} Crafting\pTrade Berries for {POKEBLOCK}."), MSGBOX_SIGN)
}

script Rogue_Market_ShopSign
{
    hubupgradeunlocked(HUB_UPGRADE_MARKET_TREAT_SHOP)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Treat Shop\nBuy treats with money."), MSGBOX_SIGN)
    }
    else
    {
        msgbox(format("Treat Shop\nClosed until the Treat Shop upgrade."), MSGBOX_SIGN)
    }
}

script Rogue_Market_KitchenSign
{
    hubupgradeunlocked(HUB_UPGRADE_MARKET_BAKERY)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Market Kitchen\pBring {POKEBLOCK} for a Pie to share with your first Pokémon."), MSGBOX_SIGN)
    }
    else
    {
        msgbox(format("Market Kitchen\nClosed until the Bakery upgrade."), MSGBOX_SIGN)
    }
}

