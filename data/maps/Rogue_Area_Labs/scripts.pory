const FLAG_HIDE_BIRCH = FLAG_TEMP_1

const VAR_RETURN_STATE = VAR_TEMP_0

const OBJ_EVENT_BIRCH = 2

mapscripts Rogue_Area_Labs_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Area_Labs_OnMapLoad
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_RETURN_STATE, 0: Rogue_Area_Labs_WarpState0
    ]
}

script Rogue_Area_Labs_OnMapLoad
{
    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_SPAWN)
    {
        clearflag(FLAG_HIDE_BIRCH)
    }
    elif(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_LEAVE_LAB)
    {
        clearflag(FLAG_HIDE_BIRCH)
        setobjectxyperm(OBJ_EVENT_BIRCH, 7, 9)
        setobjectmovementtype(OBJ_EVENT_BIRCH, MOVEMENT_TYPE_FACE_UP)
    }
    else
    {
        setflag(FLAG_HIDE_BIRCH)
    }
}

script Rogue_Area_Labs_WarpState0
{
    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_SPAWN)
    {
        call(Rogue_Area_Labs_StartGame)
    }
    elif(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_LEAVE_LAB)
    {
        call(Rogue_Area_Labs_TutorialGuide)
    }
    setvar(VAR_RETURN_STATE, 1)
}

script Rogue_Area_Labs_StartGame
{
    lock

    applymovement(OBJ_EVENT_BIRCH, BirchStartGame0)
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerStartGame0)
    waitmovement(0)

    msgbox(format("BIRCH: There you are!\nBack up on your feet now!\pYou seem fine, but perhaps it would be a good idea for you to have a wander around {POKEMON_HUB} to refresh your memory.\pOnce you're ready, come and find me in my lab."))
    closemessage

    applymovement(OBJ_EVENT_BIRCH, BirchStartGame1)
    waitmovement(0)

    opendoor(7, 6)
    waitdooranim

    applymovement(OBJ_EVENT_BIRCH, BirchStartGame2)
    waitmovement(0)
    hideobjectat(OBJ_EVENT_BIRCH, MAP_ROGUE_AREA_LABS)
    setflag(FLAG_HIDE_BIRCH)

    closedoor(7, 6)
    waitdooranim

    addvar(VAR_ROGUE_INTRO_STATE, 1)
    release
}

movement BirchStartGame0
{
    walk_in_place_right
}

movement PlayerStartGame0 
{
    face_left
}

movement BirchStartGame1
{
    walk_left
    walk_up * 2
}

movement BirchStartGame2
{
    walk_up
}

script Rogue_Area_Labs_TutorialGuide
{
    lock

    turnobject(OBJ_EVENT_BIRCH, DIR_NORTH)
    msgbox(format("BIRCH: {PLAYER}!\pQuickly, we must make haste!"))

    closemessage
    setvar(VAR_0x8004, HUB_AREA_ADVENTURE_ENTRANCE)
    special(Rogue_CheckHubConnectionDir)

    switch(var(VAR_RESULT))
    {
        case HUB_AREA_CONN_NORTH:
            applymovement(OBJ_EVENT_BIRCH, BirchTutorialGuideNorth)
            break

        case HUB_AREA_CONN_EAST:
            applymovement(OBJ_EVENT_BIRCH, BirchTutorialGuideEast)
            break

        case HUB_AREA_CONN_SOUTH:
            applymovement(OBJ_EVENT_BIRCH, BirchTutorialGuideSouth)
            break

        case HUB_AREA_CONN_WEST:
            applymovement(OBJ_EVENT_BIRCH, BirchTutorialGuideWest)
            break
    }

    waitmovement(0)
    setobjectxy(OBJ_EVENT_BIRCH, 0, 0)
    setobjectxyperm(OBJ_EVENT_BIRCH, 0, 0)
    hideobjectat(OBJ_EVENT_BIRCH, MAP_ROGUE_AREA_LABS)
    setflag(FLAG_HIDE_BIRCH)

    addvar(VAR_ROGUE_INTRO_STATE, 1)

    release
}

movement BirchTutorialGuideNorth
{
    walk_fast_right * 6
    walk_fast_up * 9
}

movement BirchTutorialGuideEast
{
    walk_fast_right * 9
}

movement BirchTutorialGuideSouth
{
    walk_fast_right * 6
    walk_fast_down * 4
}

movement BirchTutorialGuideWest
{
    walk_fast_left * 7
}

script Rogue_Area_Labs_LabSign
{
    msgbox(format("Professor Birch's Lab"), MSGBOX_SIGN)
}

script Rogue_Area_Labs_ConfigSign
{
    msgbox(format("Config Lab"), MSGBOX_SIGN)
}

script Rogue_Area_Labs_UniqueMonSign
{
    msgbox(format("The sign is worse for wear…\nOnly a few words can be made out.\p???'s Lab"), MSGBOX_SIGN)
}
