const FLAG_HIDE_BIRCH = FLAG_TEMP_1
const FLAG_HIDE_RUIN_MANIAC = FLAG_TEMP_2

const VAR_FRAME_STATE = VAR_TEMP_0

const OBJ_EVENT_BIRCH = 1
const OBJ_EVENT_ASSISTANT = 2
const OBJ_EVENT_RUIN_MANIAC = 3

mapscripts Rogue_Interior_ProfLab_MapScripts
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_ProfLab_OnMapLoad
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_FRAME_STATE, 0: Rogue_Interior_ProfLab_FrameState0
    ]
}

script Rogue_Interior_ProfLab_OnMapLoad
{
    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_EXPLORE)
    {
        clearflag(FLAG_HIDE_RUIN_MANIAC)
    }
    else
    {
        setflag(FLAG_HIDE_RUIN_MANIAC)
    }

    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_CATCH_MON)
    {
        setflag(FLAG_HIDE_BIRCH)
    }
    else
    {
        clearflag(FLAG_HIDE_BIRCH)
    }

    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_REPORT_TO_PROF)
    {
        setvar(VAR_FRAME_STATE, 0)
    }
    else
    {
        setvar(VAR_FRAME_STATE, 1)
    }
}

script Rogue_Interior_ProfLab_FrameState0
{
    lock

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)

    msgbox(format("BIRCH: Well, that was a bit more excitement than I had planned!\pBut look at you two!\nI had a feeling you'd make a good team."))
    msgbox(format("Now then, {PLAYER}!\pWould you like me to tell you a little about Adventures?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_Interior_ProfLab_TalkBirch_AdventureExplain)
    }
    else
    {
        msgbox(format("Hmhm!\pEager to get going, are you?\nThat's the spirit!"))
    }

    msgbox(format("Oh, before I forget!\nYou'll want these for the road."))
    giveitem(ITEM_POKE_BALL, 10)
    giveitem(ITEM_POTION, 5)

    special(RoguePokedex_GrantInitialGimmickItem)

    if(var(VAR_RESULT) != ITEM_NONE)
    {
        msgbox(format("Oh, and take this along, too!\pIt might come in handy on your Adventures."), MSGBOX_DEFAULT)
        call(Rogue_Common_DisplayPopups)
    }

    msgbox(format("And there's one more thing...\nYour very own Pokédex!"))
    
    if(flag(FLAG_SYS_POKEDEX_GET))
    {
        msgbox(format("Oh? Pokabbie gave you one already?\pHmhm! One step ahead of me!"))
    }
    else
    {
        callnative(Rogue_PushPopup_UnlockPokedex)
        call(Rogue_Common_DisplayPopups)
        setflag(FLAG_SYS_POKEDEX_GET)
    }
    setflag(FLAG_SYS_POKEMON_GET)

    msgbox(format("There's quite a lot packed into that little thing!\pHave a look when you get a chance. You can check your Pokémon's stats, moves, and even how they evolve."))
    msgbox(format("That should do it!\pGood luck, {PLAYER}—and come show me what you discover!"))
    closemessage

    addvar(VAR_ROGUE_INTRO_STATE, 1)
    addvar(VAR_FRAME_STATE, 1)

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ASSISTANT, IntroAssistant0)
    waitmovement(0)

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)
    msgbox(format("Hi {PLAYER}!\pYour {STR_VAR_1} seems to really enjoy walking around outside its Poké Ball.\pWould you like {STR_VAR_1} to follow you?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        setflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
        special(Rogue_SetupFollowParterMonObjectEvent)

        msgbox(format("{STR_VAR_1} looks so happy!"))
    }
    else
    {
        clearflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
        special(Rogue_SetupFollowParterMonObjectEvent)

        msgbox(format("Oh…\nIf you change your mind, just let me know."))
    }
    closemessage

    applymovement(OBJ_EVENT_ASSISTANT, IntroAssistant1)
    waitmovement(0)


    release
}

movement IntroAssistant0
{
    walk_left * 4
    walk_up * 4
}

movement IntroAssistant1
{
    walk_right
    face_left
}

script Rogue_Interior_ProfLab_TalkBirch
{
    lock
    faceplayer
    msgbox(format("BIRCH: Ah, {PLAYER}!\nGood to see you!\pWould you like to hear about Adventures?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_Interior_ProfLab_TalkBirch_AdventureExplain)
    }


    release
}

script Rogue_Interior_ProfLab_TalkAssistant
{
    lock
    faceplayer

    if(var(VAR_ROGUE_INTRO_STATE) < ROGUE_INTRO_STATE_REPORT_TO_PROF)
    {
        msgbox(format("Hi {PLAYER}!\pI hope you're doing well!\nI heard you hit your head."))
    }
    else
    {
        setvar(VAR_0x8004, 0)
        special(BufferMonNickname)
        if(flag(FLAG_SYS_SHOW_POKE_FOLLOWER))
        {
            msgbox(format("Hi {PLAYER}!\pWould you like to put {STR_VAR_1} back in its Poké Ball?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                clearflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
            }
        }
        else
        {
            msgbox(format("Hi {PLAYER}!\pWould you like {STR_VAR_1} to follow you?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                setflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
            }
        }
        special(Rogue_SetupFollowParterMonObjectEvent)
    }

    release
}

script Rogue_Interior_ProfLab_TalkBirch_AdventureExplain
{
    msgbox(format("You never quite know where an Adventure will take you!\pThe routes beyond {POKEMON_HUB} keep joining up in different ways. You might find a whole new path each time you set out!"))
    msgbox(format("Here's an odd thing...\pYour Pokémon return to a lower level when you begin an Adventure, but they still remember all their moves!"))
    msgbox(format("And your Bag seems to have a memory of its own!\pUse an item you brought along, and it'll be back when you come home.\pAnything you pick up out there disappears when you return, though."))
    msgbox(format("Oh, and keep your Pokémon in good shape!\pThe Trainers out there are always looking for a battle."))
    msgbox(format("Strange, isn't it?\pThat's why I'm so keen to see what you discover! Come back and tell me all about it."))
}

script Rogue_Interior_ProfLab_TriggerIntro0
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro0)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntro1
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro1)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntro2
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro2)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntroInternal
{
    msgbox(format("BIRCH: Ah, {PLAYER}!\nFeeling a bit more like yourself?\p{POKEMON_HUB} is coming along nicely, don't you think?\pBut those routes outside still have me scratching my head. There's something new every time I go out!\pHow about lending us a hand? You could meet all sorts of Pokémon and bring back supplies for the village.\pOf course, you'll need a Pokémon of your own first..."))

    playbgm(MUS_NONE, FALSE)
    msgbox(format("PROFFFFFFESSOR!"))
    closemessage

    setobjectxy(OBJ_EVENT_RUIN_MANIAC, 4, 11)
    //showobjectat(OBJ_EVENT_RUIN_MANIAC, MAP_ROGUE_INTERIOR_PROF_LAB)
    playbgm(MUS_HELP, FALSE)
    
    applymovement(OBJ_EVENT_RUIN_MANIAC, RuinManiacIntro0)
    waitmovement(0)

    msgbox(format("The glass broke!\nThey're loose in the Safari lab!"))

    applymovement(OBJ_EVENT_BIRCH, BirchIntro0)
    waitmovement(0)

    msgbox(format("BIRCH: What?!\nAll three of them?\pOh, dear... We'd better hurry!\n{PLAYER}, come and give me a hand!"))
    closemessage

    applymovement(OBJ_EVENT_RUIN_MANIAC, RuinManiacIntro1)
    applymovement(OBJ_EVENT_BIRCH, BirchIntro1)
    waitmovement(0)

    hideobjectat(OBJ_EVENT_RUIN_MANIAC, MAP_ROGUE_INTERIOR_PROF_LAB)
    hideobjectat(OBJ_EVENT_BIRCH, MAP_ROGUE_INTERIOR_PROF_LAB)
    setflag(FLAG_HIDE_RUIN_MANIAC)
    setflag(FLAG_HIDE_BIRCH)

    addvar(VAR_ROGUE_INTRO_STATE, 1)
}

movement PlayerIntro0
{
    walk_right
    walk_up * 2
}

movement PlayerIntro1
{
    walk_up * 2
}

movement PlayerIntro2
{
    walk_left
    walk_up * 2
}

movement RuinManiacIntro0
{
    walk_fast_up * 6
}

movement RuinManiacIntro1
{
    walk_fast_down * 10
}

movement BirchIntro0
{
    emote_exclamation_mark
}

movement BirchIntro1
{
    walk_fast_right
    walk_fast_down * 10
}
