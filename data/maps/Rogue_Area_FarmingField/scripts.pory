const FLAG_HIDE_BERRIES0 = FLAG_TEMP_1
const FLAG_HIDE_BERRIES1 = FLAG_TEMP_2
const FLAG_HIDE_BERRIES2 = FLAG_TEMP_3
const FLAG_HIDE_CAULDREN = FLAG_TEMP_4

const OBJ_EVENT_MART = 22

const VAR_BULK_BERRY_COUNT = VAR_0x8004
const VAR_BULK_BERRY_TOTAL = VAR_0x8005

const BERRY_FIELD_MENU_HARVEST_ALL = 0
const BERRY_FIELD_MENU_PLANT_5 = 1
const BERRY_FIELD_MENU_PLANT_10 = 2
const BERRY_FIELD_MENU_PLANT_20 = 3
const BERRY_FIELD_MENU_BUY_BERRIES = 4

const BERRY_FIELD_RESULT_SUCCESS = 0
const BERRY_FIELD_RESULT_NO_READY_BERRIES = 1
const BERRY_FIELD_RESULT_BAG_FULL = 2
const BERRY_FIELD_RESULT_NOT_ENOUGH_EMPTY_PATCHES = 3
const BERRY_FIELD_RESULT_NOT_ENOUGH_BERRIES = 4

mapscripts Rogue_Area_FarmingField_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Area_FarmingField_OnMapLoad
}

script Rogue_Area_FarmingField_OnMapLoad
{
    hubupgradeunlocked(HUB_UPGRADE_BERRY_FIELD_BREWING)
    if(var(VAR_RESULT) == TRUE)
    {
        clearflag(FLAG_HIDE_CAULDREN)
    }
    else
    {
        setflag(FLAG_HIDE_CAULDREN)
    }

    hubupgradeunlocked(HUB_UPGRADE_BERRY_FIELD_EXTRA_FIELD0)
    if(var(VAR_RESULT) == TRUE)
    {
        clearflag(FLAG_HIDE_BERRIES0)
    }
    else
    {
        setflag(FLAG_HIDE_BERRIES0)
    }

    hubupgradeunlocked(HUB_UPGRADE_BERRY_FIELD_EXTRA_FIELD1)
    if(var(VAR_RESULT) == TRUE)
    {
        clearflag(FLAG_HIDE_BERRIES1)
    }
    else
    {
        setflag(FLAG_HIDE_BERRIES1)
    }

    hubupgradeunlocked(HUB_UPGRADE_BERRY_FIELD_EXTRA_FIELD2)
    if(var(VAR_RESULT) == TRUE)
    {
        clearflag(FLAG_HIDE_BERRIES2)
    }
    else
    {
        setflag(FLAG_HIDE_BERRIES2)
    }
}

raw `
    .align 2
OranBerryShop::
    .2byte ITEM_POTION
    .2byte 2
    .2byte ITEM_SUPER_POTION
    .2byte 5
    .2byte ITEM_HYPER_POTION
    .2byte 20
    .2byte ITEM_MAX_POTION
    .2byte 40
    .2byte ITEM_NONE
    .2byte 0
`

script Rogue_Area_FarmingField_MakePotions
{
    lock

    turnobject(OBJ_EVENT_MART, DIR_WEST)

    msgbox(format("Oh, would you like me to help you craft some potions?"))

    message("What would you like to craft?")
    waitmessage

    rogue_custompokemart(OranBerryShop, ITEM_ORAN_BERRY)

    msgbox(format("Please let me know if you'd like to craft anything else!"))
    turnobject(OBJ_EVENT_MART, DIR_SOUTH)

    release
}

script Rogue_Area_FarmingField_SpeakBerryMerchant
{
    lock
    faceplayer

    setvar(VAR_0x8009, TRUE)
    while(var(VAR_0x8009) == TRUE)
    {
        begindynamicmultichoice
        appenddynamicmultichoice("Harvest all", BERRY_FIELD_MENU_HARVEST_ALL)
        appenddynamicmultichoice("Plant 5", BERRY_FIELD_MENU_PLANT_5)
        appenddynamicmultichoice("Plant 10", BERRY_FIELD_MENU_PLANT_10)
        appenddynamicmultichoice("Plant 20", BERRY_FIELD_MENU_PLANT_20)
        appenddynamicmultichoice("Buy berries", BERRY_FIELD_MENU_BUY_BERRIES)
        appenddynamicmultichoice("Exit", MULTI_B_PRESSED)

        message(format("Welcome!\nHow can I help with the berry field?"))
        waitmessage
        enddynamicmultichoice(1, 0, 6, TRUE)

        switch(var(VAR_RESULT))
        {
            case BERRY_FIELD_MENU_HARVEST_ALL:
                call(Rogue_Area_FarmingField_HarvestAll)

            case BERRY_FIELD_MENU_PLANT_5:
                setvar(VAR_BULK_BERRY_COUNT, 5)
                call(Rogue_Area_FarmingField_BulkPlant)

            case BERRY_FIELD_MENU_PLANT_10:
                setvar(VAR_BULK_BERRY_COUNT, 10)
                call(Rogue_Area_FarmingField_BulkPlant)

            case BERRY_FIELD_MENU_PLANT_20:
                setvar(VAR_BULK_BERRY_COUNT, 20)
                call(Rogue_Area_FarmingField_BulkPlant)

            case BERRY_FIELD_MENU_BUY_BERRIES:
                message("Which berries would you like?")
                waitmessage
                rogue_dynamicpokemart(ROGUE_SHOP_BERRIES)
                lock

            case MULTI_B_PRESSED:
                setvar(VAR_0x8009, FALSE)
        }
    }

    msgbox("Please come again!")
    release
}

script Rogue_Area_FarmingField_HarvestAll
{
    special(RogueBerryField_HarvestAll)

    switch(var(VAR_RESULT))
    {
        case BERRY_FIELD_RESULT_SUCCESS:
            buffernumberstring(STR_VAR_1, VAR_BULK_BERRY_TOTAL)
            msgbox(format("Harvested {STR_VAR_1} Berries!"))

        case BERRY_FIELD_RESULT_NO_READY_BERRIES:
            msgbox(format("There aren't any ripe Berries to harvest."))

        case BERRY_FIELD_RESULT_BAG_FULL:
            msgbox(format("The BAG is too full to harvest everything."))
    }
}

script Rogue_Area_FarmingField_BulkPlant
{
    special(RogueBerryField_CheckBulkPlantSpace)
    if(var(VAR_RESULT) == BERRY_FIELD_RESULT_SUCCESS)
    {
        fadescreen(FADE_TO_BLACK)
        closemessage
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) != 0)
        {
            bufferitemname(STR_VAR_1, VAR_ITEM_ID)
            special(RogueBerryField_BulkPlantSelected)

            switch(var(VAR_RESULT))
            {
                case BERRY_FIELD_RESULT_SUCCESS:
                    buffernumberstring(STR_VAR_1, VAR_BULK_BERRY_TOTAL)
                    msgbox(format("Planted {STR_VAR_1} Berries!"))

                case BERRY_FIELD_RESULT_NOT_ENOUGH_EMPTY_PATCHES:
                    msgbox(format("There aren't enough empty berry patches."))

                case BERRY_FIELD_RESULT_NOT_ENOUGH_BERRIES:
                    msgbox(format("You don't have enough {STR_VAR_1}."))
            }
        }
    }
    else
    {
        msgbox(format("There aren't enough empty berry patches."))
    }
}
