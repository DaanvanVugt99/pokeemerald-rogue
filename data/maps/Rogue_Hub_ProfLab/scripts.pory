const VAR_ROGUE_INTRO_STATE = VAR_LITTLEROOT_INTRO_STATE
const VAR_PICKING_STARTER = VAR_TEMP_F

const NPC_BIRCH = 1

mapscripts Rogue_Hub_ProfLab_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION: Rogue_Hub_ProfLab_OnTransition
}

script Rogue_Hub_ProfLab_OnTransition
{
    switch(var(VAR_STARTER_MON))
    {
        case 1:
            setflag(FLAG_TEMP_1)
        case 2:
            setflag(FLAG_TEMP_2)
        case 3:
            setflag(FLAG_TEMP_3)
    }
}

script Rogue_Hub_ProfLab_SpeakProf
{
    lockall
    faceplayer

    if(flag(FLAG_ROGUE_RUN_ACTIVE))
    {
        msgbox(format("BIRCH: Ah, {PLAYER}!\nBack from the field?\pHow's the Adventure treating you?"))
        call(Rogue_Hub_ProfLab_ProfShowEvos)
    }
    else
    {
        message(format("BIRCH: Ah, {PLAYER}!\pWhat would you like to look into?"))
        waitmessage
        begindynamicmultichoice(4)
        special(RoguePokedex_AppendProfessorOptions)
        enddynamicmultichoice(1, 0, 4, TRUE)

        switch(var(VAR_RESULT))
        {
            case 0:
                msgbox(format("BIRCH: Which Pokédex records would you like to focus on?"), MSGBOX_DEFAULT)
                call(Rogue_Common_SelectCuratedPokedex)

                if(var(VAR_RESULT) == YES)
                {
                    special(RoguePokedex_BufferCuratedSelection)
                    msgbox(format("BIRCH: Switch your Pokédex over to {STR_VAR_1}?"), MSGBOX_YESNO)

                    if(var(VAR_RESULT) == YES)
                    {
                        special(RoguePokedex_ApplyCuratedSelection)

                        if(var(VAR_ROGUE_INTRO_STATE) <= 3)
                        {
                            special(Rogue_RandomiseStarters)
                            msgbox(format("BIRCH: All done!\pI've found a new group of possible PARTNERS matching the {STR_VAR_1} records."), MSGBOX_DEFAULT)
                        }
                        else
                        {
                            msgbox(format("BIRCH: All done!\pFrom now on, your possible PARTNERS and wild encounters will follow the {STR_VAR_1} records."), MSGBOX_DEFAULT)
                        }
                    }
                }

            case 1:
                call(Rogue_Hub_ProfLab_ProfShowEvos)

            case 2:
                call(Rogue_Hub_ProfLab_ProfExplain)

            default:
                msgbox(format("BIRCH: No trouble at all.\pStop by whenever something catches your interest."), MSGBOX_DEFAULT)
        }
    }

    releaseall
}

script Rogue_Hub_ProfLab_ProfExplain
{
    msgbox(format("BIRCH: Would you like me to go over what we've learned about Adventures?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("BIRCH: Every Adventure leads through a different chain of routes, with different wild Pokémon and TRAINERS along the way.\pWhen you return, your Pokémon and BAG are restored to their earlier state—even evolutions are reversed."), MSGBOX_DEFAULT)
        msgbox(format("You'll also earn reward money for what you accomplished in the field.\pAnything acquired here in {POKEMON_HUB}, however, is permanent and will be waiting when you return.\pStrange, isn't it?\pThe best way to understand it is to see it for yourself.\pGo explore!"), MSGBOX_DEFAULT)
    }

    return
}

script Rogue_Hub_ProfLab_ProfCycleEvos
{
    while(var(VAR_0x8005) < VAR_RESULT)
    {
        special(Rogue_GetMonEvoParams)
        addvar(VAR_0x8005, 1) // Increment now so text below doesn't count from 0

        buffernumberstring(STR_VAR_2, VAR_0x8005)

        switch(var(VAR_0x8006))
        {
            case EVO_FRIENDSHIP:
                msgbox(format("{STR_VAR_2}. Build a strong friendship."))

            case EVO_FRIENDSHIP_DAY:
                msgbox(format("{STR_VAR_2}. Build a strong friendship during the day."))

            case EVO_FRIENDSHIP_NIGHT:
                msgbox(format("{STR_VAR_2}. Build a strong friendship during the night."))

            case EVO_LEVEL:
            case EVO_LEVEL_NINJASK:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox("{STR_VAR_2}. Reach Lv. {STR_VAR_3}.")

            case EVO_TRADE:
                msgbox(format("{STR_VAR_2}. Trade."))

            case EVO_TRADE_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Trade while holding {STR_VAR_3}."))

            case EVO_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Use a {STR_VAR_3}."))

            case EVO_LEVEL_ATK_GT_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} with Attack higher than Defense."))

            case EVO_LEVEL_ATK_EQ_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} with Attack equal to Defense."))

            case EVO_LEVEL_ATK_LT_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} with Attack lower than Defense."))

            case EVO_LEVEL_SILCOON:
            case EVO_LEVEL_CASCOON:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} with the right personality value."))

            case EVO_LEVEL_SHEDINJA:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} with room in the party."))

            case EVO_BEAUTY:
                msgbox(format("{STR_VAR_2}. Raise its Beauty."))

            case EVO_LEVEL_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Level up while holding {STR_VAR_3}."))


            // EX methods
            //
            case EVO_LEVEL_FEMALE:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} as a female."))

            case EVO_LEVEL_MALE:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} as a male."))

            case EVO_LEVEL_NIGHT:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} at night."))

            case EVO_LEVEL_DAY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} during the day."))

            case EVO_LEVEL_DUSK:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} at dusk."))

            case EVO_ITEM_HOLD_DAY:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Level up holding {STR_VAR_3} during the day."))

            case EVO_ITEM_HOLD_NIGHT:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Level up holding {STR_VAR_3} at night."))


            case EVO_MOVE:
                buffermovename(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Level up while knowing {STR_VAR_3}."))

            case EVO_MOVE_TYPE:
                msgbox(format("{STR_VAR_2}. Level up while knowing a FAIRY-type move.")) // Hard coded, as this is only instance

            case EVO_MAPSEC:
            case EVO_SPECIFIC_MAP:
                msgbox(format("{STR_VAR_2}. Level up in a certain location."))


            case EVO_ITEM_MALE:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Use a {STR_VAR_3} on a male."))

            case EVO_ITEM_FEMALE:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Use a {STR_VAR_3} on a female."))


            case EVO_LEVEL_RAIN:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} while it is raining."))

            case EVO_SPECIFIC_MON_IN_PARTY:
                bufferspeciesname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Level up with {STR_VAR_3} in the party."))

            case EVO_LEVEL_DARK_TYPE_MON_IN_PARTY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} with a DARK-type Pokémon in the party."))

            case EVO_TRADE_SPECIFIC_MON:
                bufferspeciesname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Trade for a {STR_VAR_3}."))


            case EVO_LEVEL_NATURE_AMPED:
            case EVO_LEVEL_NATURE_LOW_KEY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Reach Lv. {STR_VAR_3} with the right Nature."))

            case EVO_CRITICAL_HITS:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. Land {STR_VAR_3} critical hits in one battle."))

            case EVO_SCRIPT_TRIGGER_DMG:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. After losing at least {STR_VAR_3} HP, visit a certain place."))

            case EVO_DARK_SCROLL:
            case EVO_WATER_SCROLL:
                msgbox(format("{STR_VAR_2}. Train at a certain landmark."))

            default:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{STR_VAR_2}. UNKNOWN EVO TYPE, {STR_VAR_3}."))
        }
    }
}

script Rogue_Hub_ProfLab_ProfShowEvos
{
    msgbox(format("BIRCH: Would you like me to look into how one of your Pokémon evolves?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Which Pokémon should we examine?"))
        special(ChoosePartyMon)
        waitstate

        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            msgbox(format("BIRCH: All right.\pBring it by whenever you're curious."), MSGBOX_DEFAULT)
        }
        else
        {
            specialvar(VAR_RESULT, Rogue_GetMonEvoCount)
            special(BufferMonNickname)

            if(var(VAR_RESULT) == 0)
            {
                msgbox(format("{STR_VAR_1} doesn't appear able to evolve under any conditions we know about."))
            }
            elif(var(VAR_RESULT) == 1)
            {
                buffernumberstring(STR_VAR_2, VAR_RESULT)
                msgbox(format("Hmhm…\p{STR_VAR_1} has one known evolutionary path."))

                setvar(VAR_0x8005, 0)
                call(Rogue_Hub_ProfLab_ProfCycleEvos)
                msgbox(format("BIRCH: There you are!\pIf you want me to examine another Pokémon, just ask."), MSGBOX_DEFAULT)
            }
            else
            {
                buffernumberstring(STR_VAR_2, VAR_RESULT)
                msgbox(format("Hmhm…\p{STR_VAR_1} has {STR_VAR_2} known evolutionary paths."))

                setvar(VAR_0x8005, 0)
                call(Rogue_Hub_ProfLab_ProfCycleEvos)
                msgbox(format("BIRCH: There you are!\pIf you want me to examine another Pokémon, just ask."), MSGBOX_DEFAULT)
            }
        }

        setvar(VAR_RESULT, YES)
    }
}

script Rogue_Hub_ProfLab_TriggerPC
{
    lockall
    msgbox(format("(I shouldn't use this now)"), MSGBOX_DEFAULT)
    applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkBackwards)
    waitmovement(0)
    releaseall
}

movement Rogue_Hub_ProfLab_WalkBackwards
{
    walk_down
}

script Rogue_Hub_ProfLab_IntroCommon
{
    msgbox(format("BIRCH: {PLAYER}!\nYou made it!\pI was beginning to wonder where you'd got to.\pBefore you head into the field, you'll need a Pokémon Partner."), MSGBOX_DEFAULT)
    turnobject(NPC_BIRCH, DIR_EAST)
    msgbox(format("BIRCH: I was out surveying this morning and met a few promising Pokémon.\pHave a look and see which one takes to you!"), MSGBOX_DEFAULT)
    return
}

script Rogue_Hub_ProfLab_IntroRunAwayCommon
{
    special(Rogue_GenerateFallbackStarter)
    copyvar(VAR_0x8001, VAR_RESULT)
    bufferspeciesname(STR_VAR_1, VAR_0x8001)
    givemon(VAR_0x8001, 7, ITEM_ORAN_BERRY)

    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} obtained a {STR_VAR_1}."))
    waitmessage
    waitfanfare

    msgbox(format("BIRCH: Would you like to give {STR_VAR_1} a nickname?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        call(Common_EventScript_NameReceivedPartyMon)
    }

    setvar(VAR_STARTER_MON, 4)

    call(Rogue_Hub_ProfLab_PostStarterSelect)
    return
}

script Rogue_Hub_ProfLab_IntroTriggerL
{
    lockall
    if(var(VAR_PICKING_STARTER) != YES)
    {
        setvar(VAR_PICKING_STARTER, YES)

        applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkToProfL)
        waitmovement(0)

        call(Rogue_Hub_ProfLab_IntroCommon)
    }
    else
    {
        turnobject(NPC_BIRCH, DIR_SOUTH)
        turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

        msgbox(format("BIRCH: Oh?\pNone of these feels right?\pI can introduce you to another Pokémon."), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("BIRCH: All right—let's see who else I found!"), MSGBOX_DEFAULT)

            applymovement(NPC_BIRCH, Rogue_Hub_ProfLab_WalkFromProfL)
            waitmovement(0)

            call(Rogue_Hub_ProfLab_IntroRunAwayCommon)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkUpOne)
            waitmovement(0)
        }
    }
    releaseall
}

script Rogue_Hub_ProfLab_IntroTriggerR
{
    lockall
    if(var(VAR_PICKING_STARTER) != YES)
    {
        setvar(VAR_PICKING_STARTER, YES)

        applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkToProfR)
        waitmovement(0)

        call(Rogue_Hub_ProfLab_IntroCommon)
    }
    else
    {
        turnobject(NPC_BIRCH, DIR_SOUTH)
        turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

        msgbox(format("BIRCH: Oh?\pNone of these feels right?\pI can introduce you to another Pokémon."), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("BIRCH: All right—let's see who else I found!"), MSGBOX_DEFAULT)

            applymovement(NPC_BIRCH, Rogue_Hub_ProfLab_WalkFromProfR)
            waitmovement(0)

            call(Rogue_Hub_ProfLab_IntroRunAwayCommon)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkUpOne)
            waitmovement(0)
        }
    }
    releaseall
}

movement Rogue_Hub_ProfLab_WalkUpOne
{
    walk_up
}

movement Rogue_Hub_ProfLab_WalkToProfL
{
    walk_up * 3
}

movement Rogue_Hub_ProfLab_WalkToProfR
{
    walk_left
    walk_up * 3
}

movement Rogue_Hub_ProfLab_WalkFromProfL
{
    walk_down * 3
}

movement Rogue_Hub_ProfLab_WalkFromProfR
{
    walk_right
    walk_down * 3
}

script Rogue_Hub_ProfLab_PokeballCommon
{
    if(var(VAR_ROGUE_INTRO_STATE) <= 3)
    {
        turnobject(NPC_BIRCH, DIR_EAST)

        showmonpic(VAR_0x8001, 10, 3)
        playmoncry(VAR_0x8001, CRY_MODE_NORMAL)
        waitmoncry

        bufferspeciesname(STR_VAR_1, VAR_0x8001)
        msgbox(format("BIRCH: So, {STR_VAR_1} caught your eye?"), MSGBOX_YESNO)
        hidemonpic

        if(var(VAR_RESULT) == YES)
        {
            removeobject(VAR_LAST_TALKED)
            givemon(VAR_0x8001, 7, ITEM_ORAN_BERRY)

            playfanfare(MUS_OBTAIN_ITEM)
            message(format("{PLAYER} obtained a {STR_VAR_1}."))
            waitmessage
            waitfanfare

            msgbox(format("BIRCH: Would you like to give {STR_VAR_1} a nickname?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                call(Common_EventScript_GetGiftMonPartySlot)
                call(Common_EventScript_NameReceivedPartyMon)
            }

            turnobject(OBJ_EVENT_ID_PLAYER, DIR_WEST)
            call(Rogue_Hub_ProfLab_PostStarterSelect)

            setvar(VAR_RESULT, YES)
            return
        }
    }
    else
    {
        bufferspeciesname(STR_VAR_1, VAR_0x8001)
        msgbox(format("(Poor {STR_VAR_1}...)\p(Must be lonely...)"))
    }

    setvar(VAR_RESULT, NO)
    return
}

script Rogue_Hub_ProfLab_PostStarterSelect
{
    msgbox(format("BIRCH: Oh, yes!\pI've packed a few supplies and a Pokédex for you as well."), MSGBOX_DEFAULT)

    giveitem(ITEM_POKE_BALL, 5)
    giveitem(ITEM_POTION, 1)

    special(RoguePokedex_GrantInitialGimmickItem)

    if(var(VAR_RESULT) != ITEM_NONE)
    {
        msgbox(format("BIRCH: And based on the Pokédex you chose, I thought this might come in handy."), MSGBOX_DEFAULT)
        call(Rogue_Common_DisplayPopups)
    }

    setflag(FLAG_SYS_POKEDEX_GET)
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ROGUE_INTRO_STATE, 4)

    msgbox(format("BIRCH: You're ready for the field!\pIf you ever want your Pokédex to focus on another region, come see me."), MSGBOX_DEFAULT)

    call(Rogue_Hub_ProfLab_ProfExplain)

    special(Rogue_SetupFollowParterMonObjectEvent)
    return
}

script Rogue_Hub_ProfLab_Pokeball0
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER0)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 1)
        setflag(FLAG_TEMP_1)
    }

    release
}

script Rogue_Hub_ProfLab_Pokeball1
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER1)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 2)
        setflag(FLAG_TEMP_2)
    }

    release
}

script Rogue_Hub_ProfLab_Pokeball2
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER2)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 3)
        setflag(FLAG_TEMP_3)
    }

    release
}
