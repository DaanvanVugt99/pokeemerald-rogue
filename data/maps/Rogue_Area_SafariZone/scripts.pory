const VAR_SAFARI_INDEX = VAR_0x8008
const VAR_SAFARI_PRICE = VAR_0x8009

const SAFARI_PURCHASE_TO_PARTY = 0
const SAFARI_PURCHASE_TO_PC = 1
const SAFARI_PURCHASE_CANT_GIVE = 2
const SAFARI_PURCHASE_NOT_ENOUGH = 3
const SAFARI_PURCHASE_INVALID = 4

mapscripts Rogue_Area_SafariZone_MapScripts {}

script Rogue_Area_SafariZone_TalkSign
{
    lock

    msgbox(format("It's a sign which lists all of the Pokémon that have been recently sighted in the Safari Area!\pYou can offer {POKEBLOCK} to bring one back with you."))

    begindynamicmultichoice
    appenddynamicmultichoice("Offer {POKEBLOCK}", 0)
    appenddynamicmultichoice("Dismiss Pokémon", 1)
    appenddynamicmultichoice("Exit", MULTI_B_PRESSED)
    enddynamicmultichoice(1, 0, 3, TRUE)

    switch(var(VAR_RESULT))
    {
        case 0:
            special(RogueSafari_CompactEmptyEntries)
            special(Special_SelectSafariMonInPokedex)
            waitstate

            if(var(VAR_RESULT) != ROGUE_SAFARI_TOTAL_MONS)
            {
                copyvar(VAR_SAFARI_INDEX, VAR_RESULT)
                call(Rogue_Area_SafariZone_PurchaseSelectedMon)
            }

        case 1:
            msgbox(format("This will dismiss any Pokémon currently roaming in the Safari Area.\pAre you sure you want to do this?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                special(RogueSafari_ResetAllRegularEntries)
                special(ReloadWarpSilent)
            }
    }

    release
}

script Rogue_Area_SafariZone_PurchaseSelectedMon
{
    special(Rogue_BufferSafariMonInfo)
    msgbox(format("What would you like to offer to {STR_VAR_1}?"), MSGBOX_DEFAULT)

    special(Bag_ChoosePokeblock)
    waitstate

    if(var(VAR_ITEM_ID) != ITEM_NONE)
    {
        special(Rogue_CheckSafariMonLikesPokeblock)
        if(var(VAR_RESULT) == YES)
        {
            special(Rogue_BufferSafariMonPurchasePrice)
            bufferitemnameplural(STR_VAR_2, VAR_ITEM_ID, VAR_SAFARI_PRICE)
            msgbox(format("{STR_VAR_1} will join you for {STR_VAR_2}.\pMake this offer?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                special(Rogue_TryPurchaseSafariMon)

                switch(var(VAR_RESULT))
                {
                    case SAFARI_PURCHASE_TO_PARTY:
                        msgbox(format("{STR_VAR_1} joined your party!"))

                    case SAFARI_PURCHASE_TO_PC:
                        bufferboxname(STR_VAR_3, VAR_PC_BOX_TO_SEND_MON)
                        msgbox(format("{STR_VAR_1} was sent to {STR_VAR_3} in Pokémon Storage."))

                    case SAFARI_PURCHASE_CANT_GIVE:
                        msgbox(format("There isn't enough room in Pokémon Storage."))

                    case SAFARI_PURCHASE_NOT_ENOUGH:
                        msgbox(format("You don't have enough {POKEBLOCK}.\p{STR_VAR_2} are needed."))

                    case SAFARI_PURCHASE_INVALID:
                        msgbox(format("{STR_VAR_1} won't accept that offer."))
                }
            }
        }
        else
        {
            special(Rogue_BufferSafariMonInfo)
            msgbox(format("{STR_VAR_1} won't accept that offer."))
        }
    }
}
