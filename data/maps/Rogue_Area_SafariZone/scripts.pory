const VAR_SAFARI_SELECTED_INDEX = VAR_TEMP_A
const VAR_SAFARI_PURCHASE_CONTEXT = VAR_0x8000
const SAFARI_PURCHASE_CONTEXT_AREA = 0
const SAFARI_SELECTED_BACK = 12

mapscripts Rogue_Area_SafariZone_MapScripts
{
    MAP_SCRIPT_ON_LOAD: Rogue_Area_SafariZone_OnLoad
}

script Rogue_Area_SafariZone_OnLoad
{
    callnative(RogueSafari_SetupLabDisplays)
}

script Rogue_Area_SafariZone_InteractPC
{
    lockall

    msgbox(format("Safari Lab terminal.\pView the Pokémon housed here, or offer {POKEBLOCK} to take one with you."))

    begindynamicmultichoice
    appenddynamicmultichoice("View Pokémon", 0)
    appenddynamicmultichoice("Dismiss All", 1)
    appenddynamicmultichoice("Exit", MULTI_B_PRESSED)
    enddynamicmultichoice(1, 0, 3, TRUE)

    switch(var(VAR_RESULT))
    {
        case 0:
            setvar(VAR_RESULT, SAFARI_SELECTED_BACK)
            setvar(VAR_SAFARI_SELECTED_INDEX, ROGUE_SAFARI_TOTAL_MONS)
            while(var(VAR_RESULT) == SAFARI_SELECTED_BACK)
            {
                special(RogueSafari_CompactEmptyEntries)
                special(Special_SelectSafariMonInPokedex)
                waitstate

                if(var(VAR_RESULT) != ROGUE_SAFARI_TOTAL_MONS)
                {
                    copyvar(VAR_SAFARI_SELECTED_INDEX, VAR_RESULT)
                    setvar(VAR_SAFARI_PURCHASE_CONTEXT, SAFARI_PURCHASE_CONTEXT_AREA)
                    call(RogueSafari_PurchaseSelectedMon)
                }
            }

        case 1:
            msgbox(format("This will dismiss any Pokémon currently housed in the Safari Lab.\pAre you sure you want to do this?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                special(RogueSafari_ResetAllRegularEntries)
            }
    }

    closemessage
    special(ReloadWarpSilent)
    releaseall
}

script Rogue_Area_SafariZone_DisplayMon
{
    msgbox(format("Use the Safari PC to view the Pokémon housed here."))
}
