mapscripts Rogue_Area_SafariZone_MapScripts {}

script Rogue_Area_SafariZone_TalkSign
{
    lock

    msgbox(format("It's a sign which lists all of the Pokémon that have been recently sighted in the Safari Area!"))

    begindynamicmultichoice
    appenddynamicmultichoice("View Pokémon", 0)
    appenddynamicmultichoice("Dismiss Pokémon", 1)
    appenddynamicmultichoice("Exit", MULTI_B_PRESSED)
    enddynamicmultichoice(1, 0, 3, TRUE)

    switch(var(VAR_RESULT))
    {
        case 0:
            special(RogueSafari_CompactEmptyEntries)
            special(Special_SelectSafariMonInPokedex)
            waitstate

        case 1:
            msgbox(format("This will dismiss any Pokémon currently roaming in the Safari Area.\pAre you sure you want to do this?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                special(RogueSafari_ResetAllRegularEntries)
                special(ReloadWarpSilent)
            }
    }

    release
}
