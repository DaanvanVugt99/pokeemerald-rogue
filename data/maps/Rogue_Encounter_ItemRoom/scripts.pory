mapscripts Rogue_Encounter_ItemRoom_MapScripts {}

script Rogue_Encounter_ItemRoom_Sableye
{
    lock
    faceplayer
    playmoncry(SPECIES_SABLEYE, CRY_MODE_NORMAL)
    waitmoncry
    release
}

script Rogue_Encounter_ItemRoom_Pedestal
{
    lock

    switch(var(VAR_ROGUE_SPECIAL_ENCOUNTER_DATA1))
    {
        case 0:
            if(flag(FLAG_ROGUE_ITEM_ROOM_CLAIMED_0))
            {
                msgbox(format("The pedestal is empty."))
                release
                return
            }
        case 1:
            if(flag(FLAG_ROGUE_ITEM_ROOM_CLAIMED_1))
            {
                msgbox(format("The pedestal is empty."))
                release
                return
            }
        case 2:
            if(flag(FLAG_ROGUE_ITEM_ROOM_CLAIMED_2))
            {
                msgbox(format("The pedestal is empty."))
                release
                return
            }
        default:
            msgbox(format("Something is wrong with the pedestal."))
            release
            return
    }

    callnative(Rogue_ShowItemRoomPreview)
    waitstate

    if(var(VAR_RESULT) == YES)
    {
        special(Rogue_TryClaimItemRoomReward)

        if(var(VAR_RESULT) == YES)
        {
            setflag(FLAG_TEMP_1)
            removeobject(VAR_LAST_TALKED)
            call(Rogue_Common_DisplayPopups)
        }
        else
        {
            msgbox(format("Your Bag is full.\pThe treasure remains on the pedestal."))
        }
    }

    release
}
