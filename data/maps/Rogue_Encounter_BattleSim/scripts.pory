const FLAG_HAS_BATTLED = FLAG_TEMP_1

const VAR_CHOSEN_PRIZE = VAR_TEMP_0
const VAR_PRIZE_PARAM0 = VAR_TEMP_1
const VAR_PRIZE_PARAM1 = VAR_TEMP_2

const NPC_OBJ_JOEY = 1

mapscripts Rogue_Encounter_BattleSim_MapScripts {}

script Rogue_Encounter_BattleSim_TalkJoey
{
    lock
    faceplayer

    if(flag(FLAG_HAS_BATTLED))
    {
        msgbox(format("That was a fun battle!\nWe should do it again sometime!"))
    }
    else
    {
        msgbox(format("Well hey!\pI'm still learning how to Battle so I like using this Battle Simulator for practice!\pI like giving out prizes to strong Battlers, too!"))
        turnobject(NPC_OBJ_JOEY, DIR_WEST)
        msgbox(format("If you want to Battle me, log on to that PC over there."))
    }

    release
}

script Rogue_Encounter_BattleSim_InteractMachine
{
    lock

    if(flag(FLAG_HAS_BATTLED))
    {
        msgbox(format("The Battle Simulator is turned off."))
    }
    else
    {
        setvar(VAR_LAST_TALKED, NPC_OBJ_JOEY)
        turnobject(NPC_OBJ_JOEY, DIR_WEST)

        setvar(VAR_RESULT, 2)

        while(var(VAR_RESULT) == 2)
        {
            message(format("So you want to have a go on the Battle Simulator?"))
            waitmessage
            multichoice(20, 6, MULTI_YESNOINFO, NO)

            switch(var(VAR_RESULT))
            {
                case 0: // Yes
                    // Let it fall through
                    setvar(VAR_RESULT, 0)

                case 1: // No
                case MULTI_B_PRESSED:
                    msgbox(format("Oh, ok…\nIf you change your mind, let me know."), MSGBOX_DEFAULT)

                case 2: // Info
                    msgbox(format("In the Battle Simulator, each of us will be given 3 random {LV}50 Pokémon.\pAfter that, it's simple.\nJust win!\pIf you win, I'll give you a prize.\nIf you lose, no worries!"))
            }
        }

        if(var(VAR_RESULT) == 0)
        {
            call(Rogue_Encounter_BattleSim_ChoosePrize)
            if(var(VAR_RESULT) == YES)
            {
                call(Rogue_Encounter_BattleSim_BeginBattle)
            }
        }
    }

    release
}

script Rogue_Encounter_BattleSim_ChoosePrize
{
    setvar(VAR_RESULT, 2)

    while(var(VAR_RESULT) == 2)
    {
        message(format("So, what kind of prize would you like?"))
        waitmessage
        multichoice(20, 6, MULTI_BATTLE_WAGER, NO)

        switch(var(VAR_RESULT))
        {
            case 0: // money
                copyvar(VAR_CHOSEN_PRIZE, VAR_RESULT)
                call(Rogue_Encounter_BattleSim_ChoosePrize_Money)
                if(var(VAR_RESULT) == NO)
                {
                    // loop again
                    setvar(VAR_RESULT, 2)
                }

            case 1: // IVs
                copyvar(VAR_CHOSEN_PRIZE, VAR_RESULT)
                call(Rogue_Encounter_BattleSim_ChoosePrize_IVs)
                if(var(VAR_RESULT) == NO)
                {
                    // loop again
                    setvar(VAR_RESULT, 2)
                }

            case 2: // Items
                copyvar(VAR_CHOSEN_PRIZE, VAR_RESULT)
                call(Rogue_Encounter_BattleSim_ChoosePrize_Items)
                if(var(VAR_RESULT) == NO)
                {
                    // loop again
                    setvar(VAR_RESULT, 2)
                }
                
            case MULTI_B_PRESSED:
                msgbox(format("Oh, ok…\nIf you change your mind, let me know."), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, NO)
        }
    }
}

script Rogue_Encounter_BattleSim_ChoosePrize_Money
{
    showmoneybox(0,0)

    if(var(VAR_ROGUE_DIFFICULTY) >= ROGUE_ELITE_START_DIFFICULTY)
    {
        msgbox(format("Money?\nSure thing!\pIf you win, I'll give you ¥15000.\pSound good?"), MSGBOX_YESNO)
    }
    elif(var(VAR_ROGUE_DIFFICULTY) >= ROGUE_GYM_MID_DIFFICULTY)
    {
        msgbox(format("Money?\nSure thing!\pIf you win, I'll give you ¥10000.\pSound good?"), MSGBOX_YESNO)
    }
    else
    {
        msgbox(format("Money?\nSure thing!\pIf you win, I'll give you ¥5000.\pSound good?"), MSGBOX_YESNO)
    }

    hidemoneybox
}

script Rogue_Encounter_BattleSim_ChoosePrize_IVs
{
    bufferspeciesname(STR_VAR_1, SPECIES_RATTATA)
    msgbox(format("IVs?\nSure thing!\pPick one of your Pokémon.\pIf you win, I'll feed it some Pies to increase its IVs."), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Which Pokémon should get the prize if you win?"))
        special(ChoosePartyMon)
        waitstate

        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            setvar(VAR_RESULT, YES)
            copyvar(VAR_PRIZE_PARAM0, VAR_0x8004)
        }
    }
}

script Rogue_Encounter_BattleSim_ChoosePrize_Items
{
    special(Rogue_BattleSim_SelectPrizeItem)


    bufferitemnameplural(STR_VAR_1, VAR_PRIZE_PARAM0, VAR_PRIZE_PARAM1)
    msgbox(format("Items?\nSure thing!\pIf you win, I'll give you {STR_VAR_1}.\pSound good?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        // Check we can add a stack of a new item (use yellow shard as we won't normally encounter this item)
        checkitemspace(ITEM_YELLOW_SHARD, 1)
        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("Oh, your bag looks like it's full.\pI might not be able to give you any item if you win.\pAre you sure you want to continue?"), MSGBOX_YESNO)
        }
    }
}

script Rogue_Encounter_BattleSim_BeginBattle
{
    msgbox(format("OK!\nLet's go!"))

    trainerbattle(TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT, TRAINER_ROGUE_DYNAMIC, 0, gPlaceholder_Trainer_PostBattleTaunt)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Oh wow!\nYou're such a great Battler!\pHere you go!"))
        quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)
    }
    else
    {
        msgbox(format("Woo!\nI win!\pNo prize this time, but that was fun!"))
    }

    setflag(FLAG_HAS_BATTLED)

    switch(var(VAR_CHOSEN_PRIZE))
    {
        case 0: // money
            special(Rogue_BattleSim_HandleItemMoney)

        case 1: // IVs
            special(Rogue_BattleSim_HandleItemIVs)

        case 2: // Items
            special(Rogue_BattleSim_HandleItemPrize)
    }
}
